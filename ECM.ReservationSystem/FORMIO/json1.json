{
  "title": "تفاصيل الرحلة",
  "collapsible": false,
  "key": "reservationDetails",
  "type": "panel",
  "label": "Panel",
  "input": false,
  "tableView": false,
  "components": [
    {
      "key": "reservationUrl",
      "type": "hidden",
      "input": true,
      "defaultValue": "https://localhost:44382",
      "tableView": false,
      "label": ""
    },
    {
      "key": "requestNonce",
      "type": "hidden",
      "input": true,
      "tableView": false,
      "persistent": false,
      "calculateValue": "value = data.requestNonce || Date.now();",
      "label": ""
    },
    {
      "label": "المدينة",
      "widget": "choicesjs",
      "dataSrc": "url",
      "data": {
        "url": "{{data.reservationUrl}}/api/Reservation/cities?_ts={{data.requestNonce}}"
      },
      "valueProperty": "id",
      "template": "<span>{{ item.name }}</span>",
      "lazyLoad": false,
      "disableCache": true,
      "validate": {
        "required": true,
        "onlyAvailableItems": false
      },
      "key": "city",
      "type": "select",
      "input": true,
      "tableView": true,
      "clearOnRefresh": true
    },
    {
      "label": "الأسابيع المتاحة",
      "widget": "choicesjs",
      "dataSrc": "url",
      "data": {
        "url": "{{data.reservationUrl}}/api/Reservation/weeks/{{data.city}}?_ts={{data.requestNonce}}"
      },
      "valueProperty": "id",
      "template": "<span>{{ item.weekNumber }}</span>",
      "lazyLoad": false,
      "disableCache": true,
      "validate": {
        "required": true,
        "onlyAvailableItems": false
      },
      "refreshOn": "city",
      "redrawOn": "city",
      "clearOnRefresh": true,
      "key": "weeks",
      "type": "select",
      "input": true,
      "tableView": true
    },
    {
      "label": "الوحدات المتاحة مع الدور",
      "widget": "choicesjs",
      "dataSrc": "url",
      "data": {
        "values": [
          {
            "label": "",
            "value": ""
          }
        ],
        "url": "{{data.reservationUrl}}/api/Reservation/floors-properties/{{data.weeks}}/flat?_ts={{data.requestNonce}}",
        "headers": [
          {
            "key": "",
            "value": ""
          }
        ]
      },
      "valueProperty": "unitId",
      "template": "<span>{{ item.display }}</span>",
      "lazyLoad": false,
      "disableCache": true,
      "refreshOn": "weeks",
      "redrawOn": "weeks",
      "clearOnRefresh": true,
      "selectThreshold": 0.3,
      "validate": {
        "required": true,
        "onlyAvailableItems": false
      },
      "key": "propertyWithFloor",
      "type": "select",
      "indexeddb": {
        "filter": {}
      },
      "input": true,
      "tableView": true,
      "disableLimit": false
    },
    {
      "label": "عدد الركاب",
      "widget": "choicesjs",
      "defaultValue": "0",
      "data": {
        "values": [
          {
            "label": "0",
            "value": "0"
          },
          {
            "label": "1",
            "value": "1"
          },
          {
            "label": "2",
            "value": "2"
          },
          {
            "label": "3",
            "value": "3"
          },
          {
            "label": "4",
            "value": "4"
          },
          {
            "label": "5",
            "value": "5"
          },
          {
            "label": "6",
            "value": "6"
          }
        ]
      },
      "selectThreshold": 0.3,
      "validate": {
        "required": true,
        "onlyAvailableItems": false
      },
      "key": "passengers",
      "logic": [
        {
          "name": "loadReservationContext",
          "trigger": {
            "type": "javascript",
            "javascript": "result = !!(data.reservationUrl && data.weeks && data.propertyWithFloor);"
          },
          "actions": [
            {
              "name": "fetchReservationContext",
              "type": "customAction",
              "customAction": "var form = instance.root; var passengers = Number(data.passengers || 0); function clearAll() { form.getComponent('price').setValue(null); form.getComponent('unitPrice').setValue(null); form.getComponent('insurancePrice').setValue(null); form.getComponent('transportationPrice').setValue(null); form.getComponent('transportTotalSeats').setValue(null); form.getComponent('transportReservedSeats').setValue(null); form.getComponent('transportRemainingSeats').setValue(null); } if (!data.reservationUrl || !data.weeks || !data.propertyWithFloor) { clearAll(); return; } var ts = Date.now(); var priceUrl = data.reservationUrl + '/api/Reservation/price/' + encodeURIComponent(data.weeks) + '/' + encodeURIComponent(data.propertyWithFloor) + '?passengers=' + encodeURIComponent(passengers) + '&_ts=' + ts; var transportUrl = data.reservationUrl + '/api/Reservation/transport-status/' + encodeURIComponent(data.weeks) + '?passengers=' + encodeURIComponent(passengers) + '&_ts=' + ts; fetch(priceUrl, { method: 'GET', cache: 'no-store', headers: { 'Accept': 'application/json', 'Cache-Control': 'no-cache, no-store, must-revalidate', 'Pragma': 'no-cache', 'Expires': '0' } }).then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); }).then(function (res) { form.getComponent('price').setValue(res.total || 0); form.getComponent('unitPrice').setValue(res.unit || 0); form.getComponent('insurancePrice').setValue(res.insurance || 0); form.getComponent('transportationPrice').setValue(res.transportation || 0); }).catch(function () { form.getComponent('price').setValue(null); form.getComponent('unitPrice').setValue(null); form.getComponent('insurancePrice').setValue(null); form.getComponent('transportationPrice').setValue(null); }); fetch(transportUrl, { method: 'GET', cache: 'no-store', headers: { 'Accept': 'application/json', 'Cache-Control': 'no-cache, no-store, must-revalidate', 'Pragma': 'no-cache', 'Expires': '0' } }).then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); }).then(function (res) { var transport = res.transport || {}; form.getComponent('transportTotalSeats').setValue(transport.totalSeats != null ? transport.totalSeats : 0); form.getComponent('transportReservedSeats').setValue(transport.reservedSeats != null ? transport.reservedSeats : 0); form.getComponent('transportRemainingSeats').setValue(transport.remainingSeats != null ? transport.remainingSeats : 0); }).catch(function () { form.getComponent('transportTotalSeats').setValue(null); form.getComponent('transportReservedSeats').setValue(null); form.getComponent('transportRemainingSeats').setValue(null); });"
            }
          ]
        }
      ],
      "type": "select",
      "indexeddb": {
        "filter": {}
      },
      "input": true,
      "tableView": true
    },
    {
      "title": "تفاصيل سعة النقل",
      "collapsible": false,
      "key": "transportCapacityDetails",
      "type": "panel",
      "label": "Panel",
      "input": false,
      "tableView": false,
      "components": [
        {
          "type": "columns",
          "key": "transportColumns",
          "columns": [
            {
              "width": 4,
              "components": [
                {
                  "label": "إجمالي سعة النقل",
                  "disabled": true,
                  "clearOnHide": false,
                  "key": "transportTotalSeats",
                  "type": "number",
                  "input": true,
                  "tableView": true
                }
              ],
              "offset": 0,
              "push": 0,
              "pull": 0,
              "size": "md",
              "currentWidth": 4
            },
            {
              "width": 4,
              "components": [
                {
                  "label": "المحجوز حاليًا",
                  "disabled": true,
                  "clearOnHide": false,
                  "key": "transportReservedSeats",
                  "type": "number",
                  "input": true,
                  "tableView": true
                }
              ],
              "offset": 0,
              "push": 0,
              "pull": 0,
              "size": "md",
              "currentWidth": 4
            },
            {
              "width": 4,
              "components": [
                {
                  "label": "المتبقي",
                  "disabled": true,
                  "clearOnHide": false,
                  "key": "transportRemainingSeats",
                  "type": "number",
                  "input": true,
                  "tableView": true
                }
              ],
              "size": "md",
              "currentWidth": 4
            }
          ],
          "input": false,
          "tableView": false,
          "label": "Columns"
        }
      ]
    },
    {
      "label": "إجمالي السعر",
      "disabled": true,
      "clearOnHide": false,
      "key": "price",
      "type": "number",
      "input": true,
      "tableView": true
    },
    {
      "title": "تفاصيل السعر",
      "collapsible": false,
      "key": "priceDetails",
      "type": "panel",
      "label": "Panel",
      "input": false,
      "tableView": false,
      "components": [
        {
          "label": "سعر الوحدة",
          "disabled": true,
          "clearOnHide": false,
          "key": "unitPrice",
          "type": "number",
          "input": true,
          "tableView": true
        },
        {
          "label": "التأمين",
          "disabled": true,
          "clearOnHide": false,
          "key": "insurancePrice",
          "type": "number",
          "input": true,
          "tableView": true
        },
        {
          "label": "المواصلات",
          "disabled": true,
          "clearOnHide": false,
          "key": "transportationPrice",
          "type": "number",
          "input": true,
          "tableView": true
        }
      ]
    },
    {
      "title": "تاريخ آخر مصيف مع الشركة",
      "collapsible": false,
      "key": "lastTrip",
      "type": "panel",
      "label": "Panel",
      "input": false,
      "tableView": false,
      "components": [
        {
          "columns": [
            {
              "components": [
                {
                  "label": "الشهر",
                  "widget": "choicesjs",
                  "data": {
                    "values": [
                      {
                        "label": "يناير",
                        "value": "1"
                      },
                      {
                        "label": "فبراير",
                        "value": "2"
                      },
                      {
                        "label": "مارس",
                        "value": "3"
                      },
                      {
                        "label": "أبريل",
                        "value": "4"
                      },
                      {
                        "label": "مايو",
                        "value": "5"
                      },
                      {
                        "label": "يونيو",
                        "value": "6"
                      },
                      {
                        "label": "يوليو",
                        "value": "7"
                      },
                      {
                        "label": "أغسطس",
                        "value": "8"
                      },
                      {
                        "label": "سبتمبر",
                        "value": "9"
                      },
                      {
                        "label": "أكتوبر",
                        "value": "10"
                      },
                      {
                        "label": "نوفمبر",
                        "value": "11"
                      },
                      {
                        "label": "ديسمبر",
                        "value": "12"
                      }
                    ]
                  },
                  "valueProperty": "value",
                  "key": "month",
                  "type": "select",
                  "input": true,
                  "tableView": true
                }
              ],
              "width": 6,
              "offset": 0,
              "push": 0,
              "pull": 0,
              "size": "md",
              "currentWidth": 6
            },
            {
              "components": [
                {
                  "label": "السنة",
                  "widget": "choicesjs",
                  "dataSrc": "custom",
                  "data": {
                    "custom": "const currentYear = new Date().getFullYear();\nvalues = [];\nfor (let i = 0; i < 10; i++) {\n  values.push({ label: (currentYear - i).toString(), value: currentYear - i });\n}"
                  },
                  "valueProperty": "value",
                  "key": "year",
                  "type": "select",
                  "input": true,
                  "tableView": true
                }
              ],
              "width": 6,
              "offset": 0,
              "push": 0,
              "pull": 0,
              "size": "md",
              "currentWidth": 6
            }
          ],
          "key": "lastTripColumns",
          "type": "columns",
          "input": false,
          "tableView": false,
          "label": "Columns"
        }
      ]
    }
  ]
}
