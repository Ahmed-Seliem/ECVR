{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ECMReservationDB;MultipleActiveResultSets=true;Integrated Security=False;User=ES;Password=ES;TrustServerCertificate=True;",
    "IAM": "Server=.;Database=IAM;MultipleActiveResultSets=true;Integrated Security=False;User=ES;Password=ES;TrustServerCertificate=True;"

  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Settings": {
    "AllowHttp": true,
    "Identity": {
      "ServerURL": "http://localhost:4050/", //IAM seliem 
      "ClientId": "cffefab4-5a2b-4bda-b685-3b504fec7d2b",
      "ClientSecret": "86c349a1-9920-4af7-8b31-6ab1c61d2a01"
    },
    "AllowedHosts": "*",
    "AsposeLicenseFilePath": "Licenses/Aspose.Total.Product.Family.lic"

  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4056"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  },
  "CaseWorkflow": {
    "BaseUrl": "http://localhost:4056/",
    "ApiKey": "",
    "ReservationRequestEndpointTemplate": "/api/requests/{id}",
    "ConfirmReservationEndpointTemplate": "/api/requests/{id}/confirm"
  },
  "MockData": {
    "Enabled": true,
    "SeedReservations": false,
    "ForceReseed": false
  }
}
