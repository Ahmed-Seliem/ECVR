@model IEnumerable<ECM.ReservationSystem.Models.ViewModels.Admin.PricingViewModel>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "إدارة التسعير";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var filters = ViewBag.CurrentFilters;
    int? selectedUnitId = filters?.unitId;
    int? selectedFloorType = filters?.floorType;
}

<div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">
        <i class="fas fa-dollar-sign"></i>
        إدارة التسعير
    </h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPricingModal">
        <i class="fas fa-plus"></i>
        إضافة تسعيرة
    </button>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get">
            <div class="row g-3">
                <div class="col-lg-5">
                    <label class="form-label">الوحدة</label>
                    <select name="unitId" class="form-select select2">
                        <option value="">كل الوحدات</option>
                        @foreach (SelectListItem item in ViewBag.Units)
                        {
                            <option value="@item.Value" selected="@(item.Value == selectedUnitId?.ToString())">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-lg-4">
                    <label class="form-label">نوع الدور</label>
                    <select name="floorType" class="form-select select2">
                        <option value="">كل الأدوار</option>
                        @foreach (SelectListItem item in ViewBag.FloorTypes)
                        {
                            <option value="@item.Value" selected="@(item.Value == selectedFloorType?.ToString())">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-lg-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="fas fa-search"></i>
                        بحث
                    </button>
                    <a href="/Admin/Pricing" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-rotate-left"></i>
                        مسح
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @await Html.PartialAsync("_PricingTable", Model)
    </div>
</div>

<form id="pricingDeleteTokenForm">
    @Html.AntiForgeryToken()
</form>

<div class="modal fade" id="createPricingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/Admin/Pricing/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">إضافة تسعيرة</h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">الوحدة</label>
                            <select name="UnitId" class="form-select select2 modal-select" data-parent="#createPricingModal" required>
                                <option value="">اختر الوحدة</option>
                                @foreach (SelectListItem item in ViewBag.Units)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">نوع الدور</label>
                            <select name="FloorType" class="form-select select2 modal-select" data-parent="#createPricingModal" required>
                                <option value="">اختر نوع الدور</option>
                                @foreach (SelectListItem item in ViewBag.FloorTypes)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">السعر الأسبوعي</label>
                            <input name="WeeklyRentDefaultCapacity" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">الشخص الإضافي</label>
                            <input name="AdditionalPersonCost" type="number" step="0.01" min="0" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">التأمين</label>
                            <input name="InsuranceAmount" type="number" step="0.01" min="0" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">بداية السريان</label>
                            <input name="EffectiveFrom" type="text" class="form-control js-date-picker" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">نهاية السريان</label>
                            <input name="EffectiveTo" type="text" class="form-control js-date-picker" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="createPricingIsActive" name="IsActive" value="true" checked />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label" for="createPricingIsActive">نشط</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editPricingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editPricingForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editPricingId" name="Id" />
                <div class="modal-header">
                    <h5 class="modal-title">تعديل التسعيرة</h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">الوحدة</label>
                            <select id="editPricingUnitId" name="UnitId" class="form-select select2 modal-select" data-parent="#editPricingModal" required>
                                <option value="">اختر الوحدة</option>
                                @foreach (SelectListItem item in ViewBag.Units)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">نوع الدور</label>
                            <select id="editPricingFloorType" name="FloorType" class="form-select select2 modal-select" data-parent="#editPricingModal" required>
                                <option value="">اختر نوع الدور</option>
                                @foreach (SelectListItem item in ViewBag.FloorTypes)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">السعر الأسبوعي</label>
                            <input id="editPricingWeekly" name="WeeklyRentDefaultCapacity" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">الشخص الإضافي</label>
                            <input id="editPricingAdditional" name="AdditionalPersonCost" type="number" step="0.01" min="0" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">التأمين</label>
                            <input id="editPricingInsurance" name="InsuranceAmount" type="number" step="0.01" min="0" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">بداية السريان</label>
                            <input id="editPricingEffectiveFrom" name="EffectiveFrom" type="text" class="form-control js-date-picker" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">نهاية السريان</label>
                            <input id="editPricingEffectiveTo" name="EffectiveTo" type="text" class="form-control js-date-picker" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="editPricingIsActive" name="IsActive" value="true" />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label" for="editPricingIsActive">نشط</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ التغييرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const editModal = new bootstrap.Modal(document.getElementById('editPricingModal'));

            const setupModalSelect2 = function (modalSelector) {
                $(`${modalSelector} .modal-select`).each(function () {
                    const parent = $(this).data('parent');
                    if ($(this).hasClass('select2-hidden-accessible')) {
                        $(this).select2('destroy');
                    }
                    $(this).select2({ dropdownParent: $(parent), width: '100%' });
                });
            };

            if (typeof flatpickr !== 'undefined') {
                flatpickr('.js-date-picker', {
                    dateFormat: 'Y-m-d',
                    locale: typeof Arabic !== 'undefined' ? Arabic : 'default'
                });
            }

            $('#createPricingModal').on('shown.bs.modal', function () {
                setupModalSelect2('#createPricingModal');
                const today = new Date().toISOString().split('T')[0];
                const fromInput = $(this).find('input[name="EffectiveFrom"]');
                if (!fromInput.val()) {
                    fromInput.val(today);
                }
            });

            $('#editPricingModal').on('shown.bs.modal', function () {
                setupModalSelect2('#editPricingModal');
            });

            $(document).on('click', '.js-edit-pricing', function () {
                const btn = $(this);
                const id = btn.data('id');

                $('#editPricingId').val(id);
                $('#editPricingUnitId').val(btn.data('unitid')).trigger('change');
                $('#editPricingFloorType').val(btn.data('floortype')).trigger('change');
                $('#editPricingWeekly').val(btn.data('weekly'));
                $('#editPricingAdditional').val(btn.data('additional'));
                $('#editPricingInsurance').val(btn.data('insurance'));
                $('#editPricingEffectiveFrom').val(btn.data('effectivefrom'));
                $('#editPricingEffectiveTo').val(btn.data('effectiveto'));
                $('#editPricingIsActive').prop('checked', btn.data('active') === true || btn.data('active') === 'True');
                $('#editPricingForm').attr('action', '/Admin/Pricing/Edit/' + id);

                editModal.show();
            });

            $(document).on('click', '.js-delete-pricing', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                swal({
                    title: 'تأكيد الحذف',
                    text: `سيتم حذف تسعيرة الوحدة: ${name}`,
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، حذف',
                    cancelButtonText: 'إلغاء',
                    closeOnConfirm: true
                }, function (isConfirm) {
                    if (!isConfirm) return;

                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '/Admin/Pricing/Delete/' + id;

                    const token = document.querySelector('#pricingDeleteTokenForm input[name="__RequestVerificationToken"]').value;
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;

                    form.appendChild(tokenInput);
                    document.body.appendChild(form);
                    form.submit();
                });
            });
        });
    </script>
}
