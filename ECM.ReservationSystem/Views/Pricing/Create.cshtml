@model ECM.ReservationSystem.Models.ViewModels.Admin.PricingViewModel
@{
    ViewData["Title"] = "إضافة تسعيرة جديدة";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">إضافة تسعيرة جديدة</h1>
    <a href="/Admin/Pricings" class="btn btn-outline-secondary">العودة للقائمة</a>
</div>

<div class="card shadow">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-12">
                    <label asp-for="UnitId" class="form-label"></label>
                    <select asp-for="UnitId" asp-items="ViewBag.Units" class="form-select">
                        <option value="">اختر الوحدة</option>
                    </select>
                    <span asp-validation-for="UnitId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="WeeklyRentDefaultCapacity" class="form-label"></label>
                    <input asp-for="WeeklyRentDefaultCapacity" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="WeeklyRentDefaultCapacity" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="InsuranceAmount" class="form-label"></label>
                    <input asp-for="InsuranceAmount" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="InsuranceAmount" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TransportationCostPerPerson" class="form-label"></label>
                    <input asp-for="TransportationCostPerPerson" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="TransportationCostPerPerson" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EffectiveFrom" class="form-label"></label>
                    <input asp-for="EffectiveFrom" type="date" class="form-control" />
                    <span asp-validation-for="EffectiveFrom" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EffectiveTo" class="form-label"></label>
                    <input asp-for="EffectiveTo" type="date" class="form-control" />
                    <span asp-validation-for="EffectiveTo" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <div class="mt-3 d-flex justify-content-end gap-2">
                <a href="/Admin/Pricings" class="btn btn-outline-secondary">إلغاء</a>
                <button type="submit" class="btn btn-primary">حفظ</button>
            </div>
        </form>
    </div>
</div>
