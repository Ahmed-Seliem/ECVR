@model ECM.ReservationSystem.Models.ViewModels.Admin.PricingViewModel
@{
    ViewData["Title"] = "تفاصيل التسعيرة";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="fas fa-eye"></i>
        تفاصيل التسعيرة: @(string.IsNullOrWhiteSpace(Model.UnitNumber) ? Model.UnitName : Model.UnitNumber)
    </h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/Admin/Pricings" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-right"></i>
            العودة للقائمة
        </a>
        <a href="/Admin/Pricings/Edit/@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i>
            تحرير
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">المعلومات الأساسية</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">الوحدة:</dt>
                    <dd class="col-sm-8">@Model.UnitName</dd>
                    <dt class="col-sm-4">رقم الوحدة:</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.UnitNumber) ? "-" : Model.UnitNumber)</dd>
                    <dt class="col-sm-4">المدينة:</dt>
                    <dd class="col-sm-8">@Model.CityName</dd>
                    <dt class="col-sm-4">الحالة:</dt>
                    <dd class="col-sm-8">@(Model.IsActive ? "نشط" : "غير نشط")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">تفاصيل السعر</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">السعر الأسبوعي:</dt>
                    <dd class="col-sm-7">@Model.WeeklyRentDefaultCapacity.ToString("N2") ج</dd>
                    <dt class="col-sm-5">التأمين:</dt>
                    <dd class="col-sm-7">@Model.InsuranceAmount.ToString("N2") ج</dd>
                    <dt class="col-sm-5">النقل للفرد:</dt>
                    <dd class="col-sm-7">@Model.TransportationCostPerPerson.ToString("N2") ج</dd>
                    <dt class="col-sm-5">فترة السريان:</dt>
                    <dd class="col-sm-7">
                        من @Model.EffectiveFrom.ToString("dd/MM/yyyy")
                        @if (Model.EffectiveTo.HasValue)
                        {
                            <text><br />إلى @Model.EffectiveTo.Value.ToString("dd/MM/yyyy")</text>
                        }
                        else
                        {
                            <text><br />مفتوح</text>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>
