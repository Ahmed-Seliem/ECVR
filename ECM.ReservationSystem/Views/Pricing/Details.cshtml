@model ECM.ReservationSystem.Models.ViewModels.Admin.PricingViewModel
@{
    ViewData["Title"] = "تفاصيل التسعيرة";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="fas fa-eye"></i>
        تفاصيل التسعيرة: @Model.UnitName
    </h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <a href="/Admin/Pricing" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-right"></i>
                العودة للقائمة
            </a>
        </div>
        <div class="btn-group">
            <a href="/Admin/Pricing/Edit/@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i>
                تحرير
            </a>
        </div>
    </div>
</div>

<div class="row">
    <!-- Basic Info -->
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle"></i>
                    المعلومات الأساسية
                </h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">الوحدة:</dt>
                    <dd class="col-sm-8">
                        <strong>@Model.UnitName</strong>
                    </dd>

                    <dt class="col-sm-4">المدينة:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info">@Model.CityName</span>
                    </dd>

                    <dt class="col-sm-4">نوع الوحدة:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.UnitTypeName</span>
                    </dd>

                    <dt class="col-sm-4">نوع الدور:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary">@Model.FloorTypeDisplay</span>
                    </dd>

                    <dt class="col-sm-4">الحالة:</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success fs-6">نشط</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">غير نشط</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Pricing Info -->
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-money-bill-wave"></i>
                    تفاصيل السعر
                </h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">السعر الأسبوعي (6 أشخاص):</dt>
                    <dd class="col-sm-7 text-success fw-bold">@Model.WeeklyRentDefaultCapacity.ToString("N2") ج</dd>

                    <dt class="col-sm-5">تكلفة الشخص الإضافي:</dt>
                    <dd class="col-sm-7 text-warning fw-bold">@Model.AdditionalPersonCost.ToString("N2") ج</dd>

                    <dt class="col-sm-5">مبلغ التأمين:</dt>
                    <dd class="col-sm-7 text-info fw-bold">@Model.InsuranceAmount.ToString("N2") ج</dd>

                    <dt class="col-sm-5">فترة السريان:</dt>
                    <dd class="col-sm-7">
                        من @Model.EffectiveFrom.ToString("dd/MM/yyyy")
                        @if (Model.EffectiveTo.HasValue)
                        {
                            <text><br />إلى @Model.EffectiveTo.Value.ToString("dd/MM/yyyy")</text>
                        }
                        else
                        {
                            <text><br /><span class="text-success">مفتوح</span></text>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Statistics -->
<div class="row mt-4">
    <div class="col-md-3">
        <div class="card shadow text-white bg-success">
            <div class="card-body text-center">
                <i class="fas fa-dollar-sign fa-2x mb-2"></i>
                <h4>@Model.WeeklyRentDefaultCapacity.ToString("N0")</h4>
                <p class="mb-0">السعر الأسبوعي</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow text-white bg-warning">
            <div class="card-body text-center">
                <i class="fas fa-user-plus fa-2x mb-2"></i>
                <h4>@Model.AdditionalPersonCost.ToString("N0")</h4>
                <p class="mb-0">الشخص الإضافي</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow text-white bg-info">
            <div class="card-body text-center">
                <i class="fas fa-shield-alt fa-2x mb-2"></i>
                <h4>@Model.InsuranceAmount.ToString("N0")</h4>
                <p class="mb-0">مبلغ التأمين</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow text-white bg-primary">
            <div class="card-body text-center">
                <i class="fas fa-calendar-alt fa-2x mb-2"></i>
                <h4>@(Model.EffectiveTo.HasValue ? "محدود" : "دائم")</h4>
                <p class="mb-0">نوع الفترة</p>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-bolt"></i>
                    إجراءات سريعة
                </h5>
            </div>
            <div class="card-body">
                <div class="btn-group" role="group">
                    <a href="/Admin/Pricing/Edit/@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit"></i>
                        تعديل التسعيرة
                    </a>
                    <a href="/Admin/Pricing/Delete/@Model.Id" class="btn btn-danger">
                        <i class="fas fa-trash"></i>
                        حذف التسعيرة
                    </a>
                    <a href="/Admin/Units/Edit/@Model.UnitId" class="btn btn-info">
                        <i class="fas fa-building"></i>
                        تعديل الوحدة
                    </a>
                    <a href="/Admin/Reservations?unitId=@Model.UnitId" class="btn btn-success">
                        <i class="fas fa-calendar-check"></i>
                        عرض الحجوزات
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>