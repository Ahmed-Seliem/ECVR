@using ECM.ReservationSystem.Domain.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<ECM.ReservationSystem.Domain.Entities.Reservation>
@{
    ViewData["Title"] = "إدارة الحجوزات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var cities = ViewBag.Cities as SelectList;
    var years = ViewBag.Years as SelectList;
}

<div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0"><i class="fas fa-calendar-check"></i> إدارة الحجوزات</h1>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">المدينة</label>
                <select name="cityId" class="form-select select2">
                    <option value="">الكل</option>
                    @if (cities != null)
                    {
                        foreach (var city in cities)
                        {
                            if (city.Selected) { <option value="@city.Value" selected>@city.Text</option> }
                            else { <option value="@city.Value">@city.Text</option> }
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">السنة</label>
                <select name="year" class="form-select select2">
                    <option value="">الكل</option>
                    @if (years != null)
                    {
                        foreach (var y in years)
                        {
                            if (y.Selected) { <option value="@y.Value" selected>@y.Text</option> }
                            else { <option value="@y.Value">@y.Text</option> }
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100"> بحث</button>
                <a href="/Admin/Reservations" class="btn btn-outline-secondary w-100"> مسح</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover datatable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الموظف</th>
                        <th>الوحدة</th>
                        <th>الفترة</th>
                        <th>الأفراد</th>
                        <th>المبلغ</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Id</td>
                            <td>@r.EmployeeName <br /><small class="text-muted">@r.EmployeeNumber</small></td>
                            <td>@r.Unit?.Name <br /><small class="text-muted">@r.Unit?.City?.Name</small></td>
                            <td>@r.CheckInDate.ToString("dd/MM/yyyy") - @r.CheckOutDate.ToString("dd/MM/yyyy")</td>
                            <td>@r.NumberOfGuests</td>
                            <td>@r.TotalAmount.ToString("N2")</td>
                            <td><span class="badge bg-info">@r.Status</span></td>
                            <td>
                                <a href="/Admin/Reservations/Details/@r.Id" class="btn btn-sm btn-outline-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
