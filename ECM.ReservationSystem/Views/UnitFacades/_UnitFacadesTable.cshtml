@model IEnumerable<ECM.ReservationSystem.Domain.Entities.UnitFacade>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover datatable">
            <thead>
                <tr>
                    <th>الاسم بالانجليزية</th>
                    <th>الاسم بالعربية</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var facade in Model)
                {
                    <tr>
                        <td>@facade.Name</td>
                        <td>@facade.NameAr</td>
                        <td>
                            @if (facade.IsActive)
                            {
                                <span class="badge bg-success">نشطة</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">غير نشطة</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning js-edit-unitfacade"
                                        data-id="@facade.Id"
                                        data-name="@facade.Name"
                                        data-namear="@facade.NameAr"
                                        data-active="@facade.IsActive">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger js-delete-unitfacade" data-id="@facade.Id" data-name="@facade.NameAr">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-border-style fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">لا توجد واجهات مضافة</h5>
    </div>
}
