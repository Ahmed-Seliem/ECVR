@model ECM.ReservationSystem.Models.ViewModels.Admin.DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var statusLabelsJson = System.Text.Json.JsonSerializer.Serialize(new[] { "حجز مؤقت", "مؤكد", "ملغي" });
    var statusCountsJson = System.Text.Json.JsonSerializer.Serialize(new[] { Model.PendingReservations, Model.ConfirmedReservations, Model.CancelledReservations });
    var cityLabelsJson = System.Text.Json.JsonSerializer.Serialize(Model.CityStatistics.Select(c => c.CityName));
    var cityRevenueJson = System.Text.Json.JsonSerializer.Serialize(Model.CityStatistics.Select(c => c.Revenue));
    var cityConfirmedJson = System.Text.Json.JsonSerializer.Serialize(Model.CityStatistics.Select(c => c.ReservedUnits));

    static (string CssClass, string Text) GetStatusPresentation(ECM.ReservationSystem.Domain.Entities.ReservationStatus status)
    {
        return status switch
        {
            ECM.ReservationSystem.Domain.Entities.ReservationStatus.TemporaryHold => ("warning", "حجز مؤقت"),
            ECM.ReservationSystem.Domain.Entities.ReservationStatus.Cancelled => ("danger", "ملغي"),
            ECM.ReservationSystem.Domain.Entities.ReservationStatus.Approved => ("success", "مؤكد"),
            ECM.ReservationSystem.Domain.Entities.ReservationStatus.Confirmed => ("success", "مؤكد"),
            ECM.ReservationSystem.Domain.Entities.ReservationStatus.Paid => ("success", "مؤكد"),
            _ => ("secondary", status.ToString())
        };
    }
}

<style>
    .dashboard-chart-card canvas {
        max-height: 320px;
    }

    .dashboard-revenue-card {
        background: linear-gradient(135deg, #f8fcfa, #ffffff, #eef6ff);
    }

    .dashboard-revenue-value {
        font-size: 1.65rem;
        font-weight: 800;
        color: #17324d;
    }

    .dashboard-metric-label {
        font-size: .8rem;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        margin-bottom: .35rem;
    }
</style>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="fas fa-chart-line"></i>
        لوحة التحكم الرئيسية
    </h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <a href="/Admin/Reservations" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-calendar-check"></i>
                عرض الحجوزات
            </a>
            <a href="/Admin/Units/Availability" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-calendar-alt"></i>
                جدولة الوحدات
            </a>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-right-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">المدن المتاحة</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalCities</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-map-marker-alt fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-right-dark shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-dark text-uppercase mb-1">إجمالي الوحدات</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalUnits</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-building fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-right-secondary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">إجمالي الحجوزات</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalReservations</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-layer-group fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-right-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">الحجوزات المؤكدة</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.ConfirmedReservations</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-right-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">الحجوزات المؤقتة</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.PendingReservations</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-hourglass-half fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-right-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">الحجوزات الملغية</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.CancelledReservations</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-times-circle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-12 mb-4">
        <div class="card border-right-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">الحجوزات المؤقتة المنتهية</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.ExpiredTemporaryHolds</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-exclamation-circle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.ExpiredTemporaryHolds > 0)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-danger text-white shadow">
                <div class="card-body">
                    <div class="text-white-50 small">تنبيه</div>
                    <div class="text-white h5">يوجد @Model.ExpiredTemporaryHolds حجز مؤقت منتهي الصلاحية</div>
                    <a href="/Admin/Reservations?status=1" class="btn btn-light btn-sm mt-2">عرض الحجوزات المؤقتة</a>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.ExpiringHolds.Any())
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-left-warning shadow">
                <div class="card-header bg-warning text-dark">
                    <h6 class="m-0 font-weight-bold">
                        <i class="fas fa-exclamation-triangle"></i>
                        حجوزات مؤقتة أوشكت على انتهاء المهلة
                    </h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>اسم الموظف</th>
                                    <th>الوحدة</th>
                                    <th>انتهاء المهلة</th>
                                    <th>الوقت المتبقي</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var hold in Model.ExpiringHolds)
                                {
                                    <tr>
                                        <td>@hold.EmployeeName</td>
                                        <td>@hold.UnitName</td>
                                        <td>@hold.PaymentDeadline.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-danger">
                                            @{
                                                var hours = (int)hold.TimeRemaining.TotalHours;
                                                var minutes = hold.TimeRemaining.Minutes;
                                            }
                                            @hours ساعة و @minutes دقيقة
                                        </td>
                                        <td>
                                            <a href="/Admin/Reservations/Details/@hold.Id" class="btn btn-sm btn-outline-primary">عرض التفاصيل</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-list"></i>
                    أحدث الحجوزات
                </h6>
            </div>
            <div class="card-body">
                @if (Model.RecentReservations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-borderless table-sm">
                            <thead>
                                <tr>
                                    <th>الموظف</th>
                                    <th>الوحدة</th>
                                    <th>الحالة</th>
                                    <th>التاريخ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reservation in Model.RecentReservations)
                                {
                                    var status = GetStatusPresentation(reservation.Status);
                                    <tr>
                                        <td>@reservation.EmployeeName</td>
                                        <td>
                                            <small class="text-muted">@reservation.CityName</small><br />
                                            @reservation.UnitName
                                        </td>
                                        <td>
                                            <span class="badge bg-@status.CssClass">@status.Text</span>
                                        </td>
                                        <td>
                                            <small>@reservation.CreatedAt.ToString("dd/MM/yyyy")</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">لا توجد حجوزات حديثة</p>
                }
                <div class="text-center">
                    <a href="/Admin/Reservations" class="btn btn-primary btn-sm">عرض جميع الحجوزات</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-chart-pie"></i>
                    إحصائيات المدن
                </h6>
            </div>
            <div class="card-body">
                @if (Model.CityStatistics.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-borderless table-sm">
                            <thead>
                                <tr>
                                    <th>المدينة</th>
                                    <th>الوحدات</th>
                                    <th>مؤكد</th>
                                    <th>مؤقت</th>
                                    <th>متاح</th>
                                    <th>الإيرادات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var city in Model.CityStatistics)
                                {
                                    <tr>
                                        <td>@city.CityName</td>
                                        <td>@city.TotalUnits</td>
                                        <td><span class="badge bg-success">@city.ReservedUnits</span></td>
                                        <td><span class="badge bg-warning text-dark">@city.PendingUnits</span></td>
                                        <td><span class="badge bg-primary">@city.AvailableUnits</span></td>
                                        <td><small>@city.Revenue.ToString("C", new System.Globalization.CultureInfo("ar-EG"))</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">لا توجد بيانات إحصائية</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card shadow h-100 dashboard-chart-card">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-chart-donut"></i>
                    توزيع الحالات
                </h6>
            </div>
            <div class="card-body">
                <canvas id="reservationStatusChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card shadow h-100 dashboard-chart-card">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-chart-bar"></i>
                    أداء المدن
                </h6>
            </div>
            <div class="card-body">
                <canvas id="cityRevenueChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-4">
        <div class="card shadow dashboard-revenue-card">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-wallet"></i>
                    الإيرادات المؤكدة
                </h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="dashboard-metric-label">إجمالي الإيرادات</div>
                        <div class="dashboard-revenue-value">
                            @Model.TotalRevenue.ToString("C", new System.Globalization.CultureInfo("ar-EG"))
                        </div>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="dashboard-metric-label">إيرادات هذا الشهر</div>
                        <div class="dashboard-revenue-value">
                            @Model.MonthlyRevenue.ToString("C", new System.Globalization.CultureInfo("ar-EG"))
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="dashboard-metric-label">نسبة المؤكد من كل الحجوزات</div>
                        <div class="dashboard-revenue-value">
                            @{
                                var confirmedRatio = Model.TotalReservations > 0
                                    ? (Model.ConfirmedReservations * 100m / Model.TotalReservations)
                                    : 0m;
                            }
                            @confirmedRatio.ToString("N1")%
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (() => {
        const statusLabels = @Html.Raw(statusLabelsJson);
        const statusCounts = @Html.Raw(statusCountsJson);
        const cityLabels = @Html.Raw(cityLabelsJson);
        const cityRevenue = @Html.Raw(cityRevenueJson);
        const cityConfirmed = @Html.Raw(cityConfirmedJson);

        const commonFont = {
            family: 'Tahoma, Arial, sans-serif',
            size: 12
        };

        const statusChartCanvas = document.getElementById('reservationStatusChart');
        if (statusChartCanvas) {
            new Chart(statusChartCanvas, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusCounts,
                        backgroundColor: ['#f0ad4e', '#198754', '#dc3545'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { font: commonFont }
                        }
                    }
                }
            });
        }

        const cityRevenueCanvas = document.getElementById('cityRevenueChart');
        if (cityRevenueCanvas) {
            new Chart(cityRevenueCanvas, {
                type: 'bar',
                data: {
                    labels: cityLabels,
                    datasets: [
                        {
                            label: 'الإيرادات',
                            data: cityRevenue,
                            backgroundColor: '#0d6efd',
                            borderRadius: 8
                        },
                        {
                            label: 'الحجوزات المؤكدة',
                            data: cityConfirmed,
                            backgroundColor: '#20c997',
                            borderRadius: 8
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            ticks: { font: commonFont }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: { font: commonFont }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { font: commonFont }
                        }
                    }
                }
            });
        }
    })();
</script>
