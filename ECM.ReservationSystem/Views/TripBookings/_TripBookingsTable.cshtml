@using ECM.ReservationSystem.Domain.Entities.OneDayTrips
@model IEnumerable<ECM.ReservationSystem.Models.DTOs.OneDayTrips.TripBookingResponseDto>

@functions {
    (string CssClass, string Label) GetBookingStatus(BookingStatus status) => status switch
    {
        BookingStatus.PendingPayment => ("warning", "بانتظار الدفع"),
        BookingStatus.Confirmed => ("success", "مؤكد"),
        BookingStatus.Cancelled => ("danger", "ملغي"),
        _ => ("light", status.ToString())
    };
}

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover datatable align-middle">
            <thead>
                <tr>
                    <th>المكان</th>
                    <th>تاريخ الرحلة</th>
                    <th>رقم الموظف</th>
                    <th>اسم الموظف</th>
                    <th>عدد الأشخاص</th>
                    <th>الإجمالي</th>
                    <th>نوع الحجز</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    var status = GetBookingStatus(booking.Status);
                    var totalGuests = booking.AdultsCount + booking.ChildrenCount;
                    <tr>
                        <td>@booking.LocationName</td>
                        <td>@booking.TripDate.ToString("dd/MM/yyyy")</td>
                        <td>@booking.EmployeeNumber</td>
                        <td>@booking.EmployeeName</td>
                        <td>
                            <span class="badge bg-secondary"
                                  title="بالغين @booking.AdultsCount، أطفال @booking.ChildrenCount">
                                @totalGuests
                            </span>
                        </td>
                        <td>@booking.TotalAmount.ToString("N2")</td>
                        <td>
                            @if (booking.BookingType == TripBookingType.Pension)
                            {
                                <span class="badge bg-warning text-dark">معاشات</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">موظفين</span>
                            }
                        </td>
                        <td><span class="badge bg-@status.CssClass">@status.Label</span></td>
                        <td>
                            <div class="btn-group">
                                <a href="/Admin/TripBookings/Details/@booking.Id" class="btn btn-sm btn-outline-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (booking.Status != BookingStatus.Cancelled)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger js-cancel-booking"
                                            data-id="@booking.Id">
                                        <i class="fas fa-times"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">لا توجد حجوزات</h5>
    </div>
}
