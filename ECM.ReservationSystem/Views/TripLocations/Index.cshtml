@model IEnumerable<ECM.ReservationSystem.Models.DTOs.OneDayTrips.TripLocationResponseDto>
@{
    ViewData["Title"] = "أماكن رحلات اليوم الواحد";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">
        <i class="fas fa-map-marked-alt"></i>
        أماكن رحلات اليوم الواحد
    </h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createLocationModal">
        <i class="fas fa-plus"></i>
        إضافة مكان
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @await Html.PartialAsync("_TripLocationsTable", Model)
    </div>
</div>

<div class="modal fade" id="createLocationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Admin/TripLocations/Create" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">إضافة مكان جديد</h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">الاسم بالانجليزية</label>
                        <input name="Name" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الاسم بالعربية</label>
                        <input name="NameAr" class="form-control" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الوصف</label>
                        <textarea name="Description" class="form-control" maxlength="500" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">عدد تذاكر الموظفين</label>
                            <input name="EmployeeTicketCount" type="number" min="0" class="form-control" value="0" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">عدد تذاكر المعاشات</label>
                            <input name="PensionTicketCount" type="number" min="0" class="form-control" value="0" required />
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="createLocationActive" name="IsActive" value="true" checked />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label" for="createLocationActive">نشط</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editLocationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editLocationForm" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">تعديل المكان</h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">الاسم بالانجليزية</label>
                        <input id="editLocationName" name="Name" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الاسم بالعربية</label>
                        <input id="editLocationNameAr" name="NameAr" class="form-control" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الوصف</label>
                        <textarea id="editLocationDescription" name="Description" class="form-control" maxlength="500" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">عدد تذاكر الموظفين</label>
                            <input id="editLocationEmployeeTickets" name="EmployeeTicketCount" type="number" min="0" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">عدد تذاكر المعاشات</label>
                            <input id="editLocationPensionTickets" name="PensionTicketCount" type="number" min="0" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="editLocationIsActive" name="IsActive" value="true" />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label" for="editLocationIsActive">نشط</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ التغييرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const editModal = new bootstrap.Modal(document.getElementById('editLocationModal'));

            $(document).on('click', '.js-edit-location', function () {
                const row = $(this);
                $('#editLocationName').val(row.data('name'));
                $('#editLocationNameAr').val(row.data('namear'));
                $('#editLocationDescription').val(row.data('description'));
                $('#editLocationEmployeeTickets').val(row.data('employeetickets'));
                $('#editLocationPensionTickets').val(row.data('pensiontickets'));
                $('#editLocationIsActive').prop('checked', row.data('active') === true || row.data('active') === 'True');
                $('#editLocationForm').attr('action', '/Admin/TripLocations/Edit/' + row.data('id'));
                editModal.show();
            });

            $(document).on('click', '.js-delete-location', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                swal({
                    title: 'تأكيد الحذف',
                    text: `سيتم حذف المكان: ${name}`,
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، حذف',
                    cancelButtonText: 'إلغاء',
                    closeOnConfirm: true
                }, function (isConfirm) {
                    if (!isConfirm) return;
                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '/Admin/TripLocations/Delete/' + id;
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);
                    document.body.appendChild(form);
                    form.submit();
                });
            });
        });
    </script>
}
