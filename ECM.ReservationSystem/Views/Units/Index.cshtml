@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<ECM.ReservationSystem.Domain.Entities.Unit>
@{
    ViewData["Title"] = "إدارة الوحدات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var cities = ViewBag.Cities as SelectList;
    var unitTypes = ViewBag.UnitTypes as SelectList;
    var floorTypes = ViewBag.FloorTypes as SelectList;
}

<div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">إدارة الوحدات</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUnitModal">إضافة وحدة</button>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">المدينة</label>
                <select name="cityId" class="form-select select2">
                    <option value="">جميع المدن</option>
                    @if (cities != null)
                    {
                        foreach (var city in cities)
                        {
                            <option value="@city.Value" selected="@city.Selected">@city.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">نوع الوحدة</label>
                <select name="unitTypeId" class="form-select select2">
                    <option value="">جميع الأنواع</option>
                    @if (unitTypes != null)
                    {
                        foreach (var type in unitTypes)
                        {
                            <option value="@type.Value" selected="@type.Selected">@type.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">السنة</label>
                <input type="number" name="year" class="form-control" value="@Context.Request.Query["year"]" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-50">بحث</button>
                <a href="/Admin/Units" class="btn btn-secondary w-50">مسح</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @await Html.PartialAsync("_UnitsTable", Model)
    </div>
</div>

<form id="unitDeleteTokenForm">
    @Html.AntiForgeryToken()
</form>

<div class="modal fade" id="createUnitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form method="post" action="/Admin/Units/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">إضافة وحدة جديدة</h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">المدينة</label>
                            <select name="CityId" class="form-select select2 modal-select" data-parent="#createUnitModal" required>
                                <option value="">اختر المدينة</option>
                                @if (cities != null)
                                {
                                    foreach (var city in cities)
                                    {
                                        <option value="@city.Value">@city.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">نوع الوحدة</label>
                            <select name="UnitTypeId" class="form-select select2 modal-select" data-parent="#createUnitModal" required>
                                <option value="">اختر النوع</option>
                                @if (unitTypes != null)
                                {
                                    foreach (var type in unitTypes)
                                    {
                                        <option value="@type.Value">@type.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">اسم الوحدة </label>
                            <input name="Name" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">كود الوحدة </label>
                            <input name="Code" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">السنة</label>
                            <input name="Year" type="number" class="form-control" value="@DateTime.Now.Year" required />
                        </div>
    
                        <div class="col-md-3">
                            <label class="form-label">نوع الدور</label>
                            <select name="FloorType" class="form-select" required>
                                @if (floorTypes != null)
                                {
                                    foreach (var floor in floorTypes)
                                    {
                                        <option value="@floor.Value">@floor.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">رقم الدور</label>
                            <input name="FloorNumber" type="number" class="form-control" min="0" value="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">السعة الافتراضية</label>
                            <input name="DefaultCapacity" type="number" class="form-control" min="1" value="6" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">السعة القصوى</label>
                            <input name="MaxCapacity" type="number" class="form-control" min="1" value="10" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="createUnitActive" name="IsActive" value="true" checked />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label" for="createUnitActive">نشطة</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="createUnitIsForPensioners" name="IsForPensioners" value="true" />
                                <input type="hidden" name="IsForPensioners" value="false" />
                                <label class="form-check-label" for="createUnitIsForPensioners">للمعاشات</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">الوصف</label>
                            <textarea name="Description" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editUnitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form id="editUnitForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editUnitId" name="Id" />
                <input type="hidden" id="editUnitCreatedAt" name="CreatedAt" />
                <input type="hidden" id="editUnitCreatedByUserId" name="CreatedByUserId" />
                <div class="modal-header">
                    <h5 class="modal-title">تعديل الوحدة</h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">الاسم</label>
                            <input id="editUnitName" name="Name" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">الكود</label>
                            <input id="editUnitCode" name="Code" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">السنة</label>
                            <input id="editUnitYear" name="Year" type="number" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">المدينة</label>
                            <select id="editUnitCityId" name="CityId" class="form-select select2 modal-select" data-parent="#editUnitModal" required>
                                @if (cities != null)
                                {
                                    foreach (var city in cities)
                                    {
                                        <option value="@city.Value">@city.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">نوع الوحدة</label>
                            <select id="editUnitTypeId" name="UnitTypeId" class="form-select select2 modal-select" data-parent="#editUnitModal" required>
                                @if (unitTypes != null)
                                {
                                    foreach (var type in unitTypes)
                                    {
                                        <option value="@type.Value">@type.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">نوع الدور</label>
                            <select id="editUnitFloorType" name="FloorType" class="form-select" required>
                                @if (floorTypes != null)
                                {
                                    foreach (var floor in floorTypes)
                                    {
                                        <option value="@floor.Value">@floor.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">رقم الدور</label>
                            <input id="editUnitFloorNumber" name="FloorNumber" type="number" class="form-control" min="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">السعة الافتراضية</label>
                            <input id="editUnitDefaultCapacity" name="DefaultCapacity" type="number" class="form-control" min="1" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">السعة القصوى</label>
                            <input id="editUnitMaxCapacity" name="MaxCapacity" type="number" class="form-control" min="1" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="editUnitIsActive" name="IsActive" value="true" />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label" for="editUnitIsActive">نشطة</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="editUnitIsForPensioners" name="IsForPensioners" value="true" />
                                <input type="hidden" name="IsForPensioners" value="false" />
                                <label class="form-check-label" for="editUnitIsForPensioners">للمعاشات</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">الوصف</label>
                            <textarea id="editUnitDescription" name="Description" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ التغييرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const editModal = new bootstrap.Modal(document.getElementById('editUnitModal'));

            $('.modal-select').each(function () {
                const parent = $(this).data('parent');
                if ($(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2('destroy');
                }
                $(this).select2({ dropdownParent: $(parent), width: '100%' });
            });

            $(document).on('click', '.js-edit-unit', function () {
                const row = $(this);
                const id = row.data('id');
                $('#editUnitId').val(id);
                $('#editUnitCreatedAt').val(row.data('createdat'));
                $('#editUnitCreatedByUserId').val(row.data('createdbyuserid'));
                $('#editUnitName').val(row.data('name'));
                $('#editUnitCode').val(row.data('code'));
                $('#editUnitDescription').val(row.data('description'));
                $('#editUnitYear').val(row.data('year'));
                $('#editUnitCityId').val(String(row.data('cityid'))).trigger('change');
                $('#editUnitTypeId').val(String(row.data('unittypeid'))).trigger('change');
                $('#editUnitFloorType').val(String(row.data('floortype')));
                $('#editUnitFloorNumber').val(row.data('floornumber'));
                $('#editUnitDefaultCapacity').val(row.data('defaultcapacity'));
                $('#editUnitMaxCapacity').val(row.data('maxcapacity'));
                $('#editUnitIsActive').prop('checked', row.data('active') === true || row.data('active') === 'True');
                $('#editUnitIsForPensioners').prop('checked', row.data('isforpensioners') === true || row.data('isforpensioners') === 'True');
                $('#editUnitForm').attr('action', '/Admin/Units/Edit/' + id);
                editModal.show();
            });

            $(document).on('click', '.js-delete-unit', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                swal({
                    title: 'تأكيد الحذف',
                    text: `سيتم حذف الوحدة: ${name}`,
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، حذف',
                    cancelButtonText: 'إلغاء',
                    closeOnConfirm: true
                }, function (isConfirm) {
                    if (!isConfirm) return;
                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '/Admin/Units/Delete/' + id;
                    const token = document.querySelector('#unitDeleteTokenForm input[name="__RequestVerificationToken"]').value;
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);
                    document.body.appendChild(form);
                    form.submit();
                });
            });
        });
    </script>
}
