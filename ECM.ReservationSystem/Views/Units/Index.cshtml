@model IEnumerable<ECM.ReservationSystem.Models.Entities.Unit>
@{
    ViewData["Title"] = "إدارة الوحدات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="fas fa-building"></i>
        إدارة الوحدات
    </h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/Admin/Units/Create" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            إضافة وحدة جديدة
        </a>
    </div>
</div>

<!-- Filters Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-filter"></i>
                    تصفية النتائج
                </h6>
            </div>
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">المدينة</label>
                        <select name="cityId" class="form-select">
                            <option value="">جميع المدن</option>
                            @foreach (var city in ViewBag.Cities as SelectList)
                            {
                                <option value="@city.Value" selected="@(city.Selected ? "selected" : null)">
                                    @city.Text
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">نوع الوحدة</label>
                        <select name="unitTypeId" class="form-select">
                            <option value="">جميع الأنواع</option>
                            @foreach (var unitType in ViewBag.UnitTypes as SelectList)
                            {
                                <option value="@unitType.Value" selected="@(unitType.Selected ? "selected" : null)">
                                    @unitType.Text
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">السنة</label>
                        <select name="year" class="form-select">
                            <option value="">جميع السنوات</option>
                            @foreach (var year in ViewBag.Years as SelectList)
                            {
                                <option value="@year.Value" selected="@(year.Selected ? "selected" : null)">
                                    @year.Text
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-outline-primary me-2">
                            <i class="fas fa-search"></i>
                            تصفية
                        </button>
                        <a href="/Admin/Units" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i>
                            مسح
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>الكود</th>
                                    <th>الاسم</th>
                                    <th>المدينة</th>
                                    <th>نوع الوحدة</th>
                                    <th>السعة الافتراضية</th>
                                    <th>السعة القصوى</th>
                                    <th>نوع الدور</th>
                                    <th>رقم الدور</th>
                                    <th>السنة</th>
                                    <th>الحالة</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var unit in Model)
                                {
                                    <tr>
                                        <td>
                                            <code class="bg-light px-2 py-1 rounded">@unit.Code</code>
                                        </td>
                                        <td>@unit.Name</td>
                                        <td>
                                            <span class="badge bg-info">@unit.City.Name</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@unit.UnitType.Name</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary">@unit.DefaultCapacity</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-warning text-dark">@unit.MaxCapacity</span>
                                        </td>
                                        <td>
                                            @switch (unit.FloorType)
                                            {
                                                case ECM.ReservationSystem.Models.Entities.FloorType.GroundFloor:
                                                    <span class="badge bg-success">دور أرضي</span>
                                                    break;
                                                case ECM.ReservationSystem.Models.Entities.FloorType.MiddleFloor:
                                                    <span class="badge bg-info">دور متكرر</span>
                                                    break;
                                                case ECM.ReservationSystem.Models.Entities.FloorType.TopFloor:
                                                    <span class="badge bg-dark">دور أخير</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@unit.FloorNumber</td>
                                        <td>@unit.Year</td>
                                        <td>
                                            @if (unit.IsActive)
                                            {
                                                <span class="badge bg-success">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">غير نشط</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="/Admin/Units/Details/@unit.Id" class="btn btn-sm btn-outline-info" title="التفاصيل">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="/Admin/Units/Edit/@unit.Id" class="btn btn-sm btn-outline-warning" title="تحرير">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="/Admin/Units/Delete/@unit.Id" class="btn btn-sm btn-outline-danger" title="حذف">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Statistics -->
                    <div class="row mt-4">
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h3>@Model.Count()</h3>
                                    <p class="mb-0">إجمالي الوحدات</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h3>@Model.Count(u => u.IsActive)</h3>
                                    <p class="mb-0">الوحدات النشطة</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning text-white">
                                <div class="card-body text-center">
                                    <h3>@Model.Sum(u => u.DefaultCapacity)</h3>
                                    <p class="mb-0">إجمالي السعة الافتراضية</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center">
                                    <h3>@Model.Sum(u => u.MaxCapacity)</h3>
                                    <p class="mb-0">إجمالي السعة القصوى</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-building fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">لا توجد وحدات مضافة</h5>
                        <p class="text-muted">ابدأ بإضافة الوحدات المتاحة للحجز</p>
                        <a href="/Admin/Units/Create" class="btn btn-primary">
                            <i class="fas fa-plus"></i>
                            إضافة أول وحدة
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>