@model ECM.ReservationSystem.Domain.Entities.Unit
@{
    ViewData["Title"] = "تفاصيل الوحدة";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentPricing = Model.Pricings?
        .Where(p => p.IsActive)
        .OrderByDescending(p => p.EffectiveFrom)
        .FirstOrDefault();
}

<div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-3 border-bottom">
    <div>
        <h1 class="h2 mb-0">تفاصيل الوحدة</h1>
        <div class="text-muted mt-1">@Model.City?.Name - @(string.IsNullOrWhiteSpace(Model.Code) ? Model.Name : Model.Code)</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/Units" class="btn btn-secondary">العودة للقائمة</a>
        <a href="/Admin/Units/Edit/@Model.Id" class="btn btn-warning">تحرير</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="row g-3">
@*                     <div class="col-md-6">
                        <div class="small text-muted">اسم الوحدة</div>
                        <div class="fw-bold">@Model.Name</div>
                    </div> *@
                    <div class="col-md-6">
                        <div class="small text-muted">رقم الوحدة</div>
                        <div class="fw-bold">@(string.IsNullOrWhiteSpace(Model.Code) ? "-" : Model.Code)</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">المدينة</div>
                        <div class="fw-bold">@Model.City?.Name</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">نوع الوحدة</div>
                        <div class="fw-bold">@Model.UnitType?.Name</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">الواجهة</div>
                        <div class="fw-bold">@(Model.UnitFacade?.NameAr ?? Model.UnitFacade?.Name ?? "-")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">رقم الدور</div>
                        <div class="fw-bold">@Model.FloorNumber</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">السعة</div>
                        <div class="fw-bold">@Model.DefaultCapacity</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">عدد الغرف</div>
                        <div class="fw-bold">@Model.RoomCount</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">السنة</div>
                        <div class="fw-bold">@Model.Year</div>
                    </div>
                    <div class="col-md-12">
                        <div class="small text-muted">الوصف</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.Description) ? "لا يوجد وصف" : Model.Description)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="small text-muted">الحالة</div>
                <div class="mt-1">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">نشط</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">غير نشط</span>
                    }
                    @if (Model.IsForPensioners)
                    {
                        <span class="badge bg-info">للمعاشات</span>
                    }
                </div>
                <hr />
                <div class="small text-muted">الحجوزات</div>
                <div class="fw-bold">@Model.Reservations.Count()</div>
                <div class="small text-muted mt-2">الفترات المجدولة</div>
                <div class="fw-bold">@Model.ScheduleSlots.Count(s => s.IsActive)</div>
                <div class="small text-muted mt-2">التسعيرات</div>
                <div class="fw-bold">@Model.Pricings.Count()</div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body d-grid gap-2">
                <a href="/Admin/Pricings?unitId=@Model.Id" class="btn btn-success">التسعير </a>
                <a href="/Admin/Units/Availability?unitId=@Model.Id&year=@Model.Year" class="btn btn-primary">جدولة الوحدة</a>
                <a href="/Admin/Reservations?unitId=@Model.Id" class="btn btn-info">الحجوزات</a>
            </div>
        </div>
    </div>
</div>

@if (currentPricing != null)
{
    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <h5 class="mb-3">ملخص آخر تسعيرة</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="small text-muted">السعر الأسبوعي</div>
                    <div class="fw-bold">@currentPricing.WeeklyRentDefaultCapacity.ToString("N2") ج</div>
                </div>
                <div class="col-md-4">
                    <div class="small text-muted">التأمين</div>
                    <div class="fw-bold">@currentPricing.InsuranceAmount.ToString("N2") ج</div>
                </div>
                <div class="col-md-4">
                    <div class="small text-muted">النقل للفرد</div>
                    <div class="fw-bold">@currentPricing.TransportationCostPerPerson.ToString("N2") ج</div>
                </div>
            </div>
        </div>
    </div>
}
