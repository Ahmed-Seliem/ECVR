@model ECM.ReservationSystem.Models.ViewModels.Admin.UnitsAvailabilityPageViewModel
@{
    ViewData["Title"] = "جدولة الوحدات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@functions {
    private static string ResolveCategory(ECM.ReservationSystem.Models.ViewModels.Admin.UnitAvailabilityViewModel unit)
    {
        var unitType = unit.UnitTypeName ?? string.Empty;
        if (unitType.Contains("شقة")) return "الشقق";
        if (unitType.Contains("فيلا")) return "الفيلات";
        if (unitType.Contains("شاليه")) return "الشاليهات";
        return string.IsNullOrWhiteSpace(unitType) ? "وحدات أخرى" : unitType;
    }
}

<style>
    .availability-page {
        direction: rtl;
    }

    .page-hero, .panel-card, .unit-card {
        border: 0;
        border-radius: 24px;
        box-shadow: 0 16px 36px rgba(15,23,42,.08);
    }

    .page-hero {
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg,#f7f2e8,#fff,#eef6ff);
    }

        .page-hero h1 {
            margin: 0;
            color: #17324d;
            font-weight: 800;
        }

        .page-hero p {
            margin: .4rem 0 0;
            color: #68798c;
        }

    .hero-note {
        display: inline-block;
        margin-top: .9rem;
        padding: .55rem .9rem;
        border-radius: 999px;
        background: rgba(23,50,77,.08);
        color: #17324d;
        font-weight: 700;
    }

    .panel-card {
        margin-bottom: 1rem;
    }

        .panel-card .card-header {
            background: #fff8ef;
            border-bottom: 1px solid #f0e1c8;
            font-weight: 800;
            color: #6f4e1f;
        }

    .city-accordion .accordion-item, .category-accordion .accordion-item {
        border: 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 12px 28px rgba(15,23,42,.06);
        margin-bottom: 1rem;
    }

    .city-accordion .accordion-button, .category-accordion .accordion-button {
        font-weight: 800;
        color: #17324d;
    }

    .unit-card {
        background: #fff;
    }

        .unit-card .card-body {
            padding: 1.35rem;
        }

    .unit-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .unit-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 800;
        color: #17324d;
    }

    .unit-subtitle {
        margin-top: .35rem;
        color: #6c7b89;
    }

    .unit-actions, .slot-actions, .slot-tools, .slot-toggle {
        display: flex;
        gap: .65rem;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
    }

    .slots-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(295px,1fr));
        gap: 1rem;
    }

    .schedule-slot {
        border-radius: 22px;
        padding: 1rem;
        border: 2px solid transparent;
        min-height: 100%;
    }

    .slot-available {
        background: #f2fff7;
        border-color: #9ddfc0;
    }

    .slot-pending {
        background: #fff9e8;
        border-color: #f1d170;
    }

    .slot-booked {
        background: #ef9ca7;
        border-color: #b32929;
    }

    .slot-inactive {
        background: #f5f7f9;
        border-color: #d7dee6;
    }

    .slot-head {
        display: flex;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .85rem;
    }

    .slot-name {
        font-weight: 800;
        color: #17324d;
    }

    .slot-dates {
        color: #68798c;
        font-size: .92rem;
    }

    .slot-status-badge {
        padding: 1.4rem 1rem;
        border-radius: 45px;
        background: rgba(255,255,255,.9);
        font-weight: 800;
    }

    .slot-prices {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .6rem;
        margin-bottom: .8rem;
    }

    .slot-price-box {
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(23,50,77,.08);
        border-radius: 16px;
        padding: .75rem;
    }

        .slot-price-box small {
            display: block;
            color: #6c7b89;
            margin-bottom: .25rem;
        }

        .slot-price-box strong {
            color: #17324d;
            font-size: 1rem;
        }

    .slot-note, .slot-employee {
        margin-bottom: .75rem;
        color: #4f5d6c;
        font-weight: 700;

    }

    .stats-row {
        display: flex;
        gap: .6rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

        .stats-row .badge {
            padding: .7rem 1rem;
            border-radius: 999px;
            font-size: .9rem;
        }

    @@media (max-width: 767.98px) {
        .slot-prices {
            grid-template-columns: 1fr;
        }

        .unit-header, .slot-actions, .slot-tools, .slot-toggle {
            display: grid;
        }
    }
</style>

<div class="availability-page">
    <div class="page-hero">
        <h1>جدولة الوحدات</h1>
    </div>

    <div class="card panel-card">
        <div class="card-header">الفلاتر</div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">السنة</label>
                    <select name="year" class="form-select select2">
                        @foreach (var y in (IEnumerable<int>)ViewBag.AvailableYears)
                        {
                            <option value="@y" selected="@(Model.Year == y)">@y</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">المدينة</label>
                    <select name="cityId" asp-items="ViewBag.Cities" class="form-select select2"><option value="">الكل</option></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">نوع الوحدة</label>
                    <select name="unitTypeId" asp-items="ViewBag.UnitTypes" class="form-select select2"><option value="">الكل</option></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">الفئة</label>
                    <select name="isForManagement" asp-items="ViewBag.AudienceOptions" class="form-select select2"></select>
                </div>
                <div class="col-md-9">
                    <label class="form-label">الوحدة</label>
                    <select name="unitId" asp-items="ViewBag.Units" class="form-select select2"><option value="">الكل</option></select>
                </div>
                <div class="col-md-3 d-flex gap-2 align-items-end">
                    <button type="submit" class="btn btn-primary w-50">بحث</button>
                    <a href="/Admin/Units/Availability" class="btn btn-outline-secondary w-50">مسح</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card panel-card mb-4">
        <div class="card-header">إنشاء الفترات</div>
        <div class="card-body">
            <form method="post" action="/Admin/Units/Availability/CreateSchedule" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CityId" value="@Model.CityId" />
                <input type="hidden" name="UnitTypeId" value="@Model.UnitTypeId" />
                <input type="hidden" name="IsForManagement" value="@Model.IsForManagement" />
                <div class="col-md-4">
                    <label class="form-label">الوحدة</label>
                    <select name="UnitId" asp-items="ViewBag.Units" class="form-select select2" required><option value="">اختر الوحدة</option></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">السنة</label>
                    <input name="Year" class="form-control" type="number" value="@Model.Year" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">من شهر</label>
                    <select name="StartMonth" class="form-select select2" required>@for (var month = 1; month <= 12; month++) { <option value="@month">@month</option> }</select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">إلى شهر</label>
                    <select name="EndMonth" class="form-select select2" required>@for (var month = 1; month <= 12; month++) { <option value="@month">@month</option> }</select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">ملاحظات</label>
                    <input name="Notes" class="form-control" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">اسم الفترة</label>
                    <input name="SlotName" class="form-control" placeholder="مثال: صيف 2026" />
                </div>
                <div class="col-md-4"><button type="submit" class="btn btn-primary w-100">إضافة الفترات</button></div>
            </form>
        </div>
    </div>

    <form id="slotTokenForm">@Html.AntiForgeryToken()</form>

    @if (Model.Units.Any())
    {
        var cityGroups = Model.Units.GroupBy(u => u.CityName).OrderBy(g => g.Key);

        <div class="accordion city-accordion" id="cityAccordion">
            @foreach (var cityGroup in cityGroups)
            {
                var cityCollapseId = $"city-{Math.Abs(cityGroup.Key.GetHashCode())}";
                var categoryGroups = cityGroup.GroupBy(ResolveCategory).OrderBy(g => g.Key).ToList();

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@cityCollapseId">
                            <div class="d-flex justify-content-between align-items-center w-100">
                                <span>@cityGroup.Key</span>
                                <span class="badge bg-primary rounded-pill">@cityGroup.Count() وحدة</span>
                            </div>
                        </button>
                    </h2>
                    <div id="@cityCollapseId" class="accordion-collapse collapse" data-bs-parent="#cityAccordion">
                        <div class="accordion-body">
                            <div class="accordion category-accordion" id="categoryAccordion-@cityCollapseId">
                                @foreach (var categoryGroup in categoryGroups)
                                {
                                    var categoryCollapseId = $"{cityCollapseId}-{Math.Abs(categoryGroup.Key.GetHashCode())}";
                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@categoryCollapseId">
                                                <div class="d-flex justify-content-between align-items-center w-100">
                                                    <span>@categoryGroup.Key</span>
                                                    <span class="badge bg-secondary rounded-pill">@categoryGroup.Count() وحدة</span>
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="@categoryCollapseId" class="accordion-collapse collapse" data-bs-parent="#categoryAccordion-@cityCollapseId">
                                            <div class="accordion-body">
                                                <div class="row g-3">
                                                    @foreach (var item in categoryGroup)
                                                    {
                                                        var available = item.WeekAvailabilities.Count(w => w.IsAvailable && w.IsActive);
                                                        var pending = item.WeekAvailabilities.Count(w => w.IsPending);
                                                        var reserved = item.WeekAvailabilities.Count(w => w.IsReserved);
                                                        var inactive = item.WeekAvailabilities.Count(w => !w.IsActive);

                                                        <div class="col-12">
                                                            <div class="card unit-card">
                                                                <div class="card-body">
                                                                    <div class="unit-header">
                                                                        <div>
                                                                            <h3 class="unit-title">
                                                                                @(string.IsNullOrWhiteSpace(item.UnitCode) ? "-" : item.UnitCode)
                                                                                -
                                                                                @(string.IsNullOrWhiteSpace(item.FacadeName) ? "-" : item.FacadeName)
                                                                                -
                                                                                @(string.IsNullOrWhiteSpace(item.FloorDisplayName) ? "-" : item.FloorDisplayName)
                                                                            </h3>
                                                                            <div class="unit-subtitle">@item.UnitTypeName</div>
                                                                        </div>
                                                                        <div class="unit-actions">
                                                                            <a href="/Admin/Units/Details/@item.UnitId" class="btn btn-outline-primary">التفاصيل</a>
                                                                            <a href="/Admin/Pricings?unitId=@item.UnitId" class="btn btn-outline-success">التسعير</a>
                                                                            <button type="button" class="btn btn-outline-danger js-delete-unit-slots"
                                                                                    data-unitid="@item.UnitId" data-unitname="@item.UnitCode" data-cityid="@Model.CityId"
                                                                                    data-unittypeid="@Model.UnitTypeId" data-year="@Model.Year" data-isformanagement="@Model.IsForManagement">
                                                                                حذف فترات الوحدة
                                                                            </button>
                                                                        </div>
                                                                    </div>

                                                                    @if (item.WeekAvailabilities.Any())
                                                                    {
                                                                        <div class="slots-grid">
                                                                            @foreach (var slot in item.WeekAvailabilities)
                                                                            {
                                                                                var slotClass = slot.IsReserved ? "slot-booked" : slot.IsPending ? "slot-pending" : slot.IsActive ? "slot-available" : "slot-inactive";
                                                                                var statusText = slot.IsReserved ? "محجوز" : slot.IsPending ? "معلق" : slot.IsActive ? "متاح" : "غير نشط";

                                                                                <div class="schedule-slot @slotClass">
                                                                                    <div class="slot-head">
                                                                                        <div>
                                                                                            <div class="slot-name">@slot.SlotName</div>
                                                                                            <div class="slot-dates">@slot.WeekStartDate.ToString("dd/MM/yyyy") - @slot.WeekEndDate.ToString("dd/MM/yyyy")</div>
                                                                                        </div>
                                                                                        <span class="slot-status-badge">@statusText</span>
                                                                                    </div>

                                                                                    <div class="slot-prices">
                                                                                        <div class="slot-price-box">
                                                                                            <small>السعر الأساسي</small>
                                                                                            <strong class="js-slot-default-price-display">@((slot.DefaultUnitPrice > 0 ? slot.DefaultUnitPrice : slot.BaseUnitPrice).ToString("N2"))</strong>
                                                                                        </div>
                                                                                        <div class="slot-price-box">
                                                                                            <small>السعر المطبق</small>
                                                                                            <strong class="js-slot-price-display">@slot.BaseUnitPrice.ToString("N2")</strong>
                                                                                            <div class="mt-2"><span class="badge bg-light text-dark js-slot-price-badge">@(slot.HasCustomUnitPrice ? "مخصص" : "افتراضي")</span></div>
                                                                                        </div>
                                                                                    </div>

                                                                                    @if (!string.IsNullOrWhiteSpace(slot.EmployeeName))
                                                                                    {
                                                                                        <div class="slot-employee">الموظف: @slot.EmployeeName</div>
                                                                                    }

                                                                                    @if (!string.IsNullOrWhiteSpace(slot.Notes))
                                                                                    {
                                                                                        <div class="slot-note">@slot.Notes</div>
                                                                                    }

                                                                                    @if (slot.SlotId.HasValue)
                                                                                    {
                                                                                        <div class="slot-tools mb-2">
                                                                                            <div class="flex-grow-1">
                                                                                                <input type="number" class="form-control js-slot-price-input" min="0" step="0.01"
                                                                                                       value="@slot.BaseUnitPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                                                                       data-defaultprice="@slot.DefaultUnitPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">
                                                                                            </div>
                                                                                            <button type="button" class="btn btn-primary js-save-slot-price"
                                                                                                    data-slotid="@slot.SlotId" data-cityid="@Model.CityId" data-unittypeid="@Model.UnitTypeId"
                                                                                                    data-unitid="@item.UnitId" data-year="@Model.Year" data-isformanagement="@Model.IsForManagement">
                                                                                                حفظ السعر
                                                                                            </button>
                                                                                        </div>

                                                                                        <div class="slot-actions">
                                                                                            <button type="button" class="btn btn-outline-danger js-delete-slot"
                                                                                                    data-slotid="@slot.SlotId" data-slotname="@slot.SlotName" data-cityid="@Model.CityId"
                                                                                                    data-unittypeid="@Model.UnitTypeId" data-unitid="@item.UnitId" data-year="@Model.Year"
                                                                                                    data-isformanagement="@Model.IsForManagement">
                                                                                                حذف الفترة
                                                                                            </button>

                                                                                            <div class="slot-toggle">
                                                                                                <div>
                                                                                                    <div class="fw-bold text-dark">التحكم في الحالة</div>
                                                                                                    <div class="small text-muted">@(slot.IsActive ? "الفترة مفعلة حاليًا" : "الفترة غير مفعلة حاليًا")</div>
                                                                                                </div>
                                                                                                <div class="form-check form-switch m-0">
                                                                                                    <input class="form-check-input js-toggle-slot-status" type="checkbox" role="switch"
                                                                                                           @(slot.IsActive ? "checked" : "") data-slotid="@slot.SlotId" data-slotname="@slot.SlotName"
                                                                                                           data-actionlabel="@(slot.IsActive ? "تعطيل" : "تفعيل")" data-cityid="@Model.CityId"
                                                                                                           data-unittypeid="@Model.UnitTypeId" data-unitid="@item.UnitId" data-year="@Model.Year"
                                                                                                           data-isformanagement="@Model.IsForManagement">
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                        </div>

                                                                        <div class="stats-row">
                                                                            <span class="badge text-bg-success">متاح: @available</span>
                                                                            <span class="badge text-bg-warning">معلق: @pending</span>
                                                                            <span class="badge text-bg-danger">محجوز: @reserved</span>
                                                                            <span class="badge text-bg-secondary">غير نشط: @inactive</span>
                                                                            <span class="badge text-bg-dark">إجمالي الفترات: @item.WeekAvailabilities.Count</span>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="alert alert-warning mb-0">لا توجد فترات مجدولة لهذه الوحدة.</div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">لا توجد وحدات مطابقة للفلاتر الحالية.</div>
    }
</div>

@section Scripts {
    <script>
        $(function () {
            function buildPostForm(action, fields) {
                const form = document.createElement('form');
                form.method = 'post';
                form.action = action;
                Object.entries(fields).forEach(([key, value]) => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = key;
                    input.value = value;
                    form.appendChild(input);
                });
                document.body.appendChild(form);
                return form;
            }

            function getToken() {
                return document.querySelector('#slotTokenForm input[name="__RequestVerificationToken"]').value;
            }

            function updateStats(card) {
                const slots = card.find('.schedule-slot');
                const stats = card.find('.stats-row .badge');
                if (stats.length < 5) return;
                stats.eq(0).text('متاح: ' + slots.filter('.slot-available').length);
                stats.eq(1).text('معلق: ' + slots.filter('.slot-pending').length);
                stats.eq(2).text('محجوز: ' + slots.filter('.slot-booked').length);
                stats.eq(3).text('غير نشط: ' + slots.filter('.slot-inactive').length);
                stats.eq(4).text('إجمالي الفترات: ' + slots.length);
            }

            function applySlotState(toggle, isActive) {
                const slot = toggle.closest('.schedule-slot');
                const statusBadge = slot.find('.slot-status-badge');
                const stateText = slot.find('.slot-toggle .small');
                const actionLabel = isActive ? 'تعطيل' : 'تفعيل';
                const isReserved = slot.hasClass('slot-booked');
                const isPending = slot.hasClass('slot-pending');

                toggle.prop('checked', isActive);
                toggle.data('actionlabel', actionLabel);
                toggle.attr('data-actionlabel', actionLabel);
                stateText.text(isActive ? 'الفترة مفعلة حاليًا' : 'الفترة غير مفعلة حاليًا');

                if (!isReserved && !isPending) {
                    slot.removeClass('slot-available slot-inactive').addClass(isActive ? 'slot-available' : 'slot-inactive');
                    statusBadge.text(isActive ? 'متاح' : 'غير نشط');
                }

                updateStats(slot.closest('.unit-card'));
            }

            $(document).on('click', '.js-delete-slot', function () {
                const button = $(this);
                swal({
                    title: 'تأكيد الحذف',
                    text: `سيتم حذف الفترة: ${button.data('slotname')}`,
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، حذف',
                    cancelButtonText: 'إلغاء',
                    closeOnConfirm: true
                }, function (isConfirm) {
                    if (!isConfirm) return;
                    buildPostForm('/Admin/Units/Availability/DeleteSlot/' + button.data('slotid'), {
                        __RequestVerificationToken: getToken(),
                        cityId: button.data('cityid') ?? '',
                        unitTypeId: button.data('unittypeid') ?? '',
                        unitId: button.data('unitid') ?? '',
                        year: button.data('year') ?? '',
                        isForManagement: button.data('isformanagement') ?? ''
                    }).submit();
                });
            });

            $(document).on('click', '.js-delete-unit-slots', function () {
                const button = $(this);
                swal({
                    title: 'تأكيد الحذف',
                    text: `سيتم حذف كل الفترات القابلة للحذف للوحدة: ${button.data('unitname') || button.data('unitid')}`,
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، حذف الفترات',
                    cancelButtonText: 'إلغاء',
                    closeOnConfirm: true
                }, function (isConfirm) {
                    if (!isConfirm) return;
                    buildPostForm('/Admin/Units/Availability/DeleteAllSlots', {
                        __RequestVerificationToken: getToken(),
                        cityId: button.data('cityid') ?? '',
                        unitTypeId: button.data('unittypeid') ?? '',
                        unitId: button.data('unitid') ?? '',
                        year: button.data('year') ?? '',
                        isForManagement: button.data('isformanagement') ?? ''
                    }).submit();
                });
            });

            $(document).on('change', '.js-toggle-slot-status', function () {
                const button = $(this);
                const nextState = button.is(':checked');
                const actionLabel = nextState ? 'تفعيل' : 'تعطيل';
                swal({
                    title: 'تأكيد الإجراء',
                    text: `${actionLabel} الفترة: ${button.data('slotname')}`,
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: `نعم، ${actionLabel}`,
                    cancelButtonText: 'إلغاء',
                    closeOnConfirm: true
                }, function (isConfirm) {
                    if (!isConfirm) {
                        button.prop('checked', !nextState);
                        return;
                    }

                    button.prop('disabled', true);
                    $.ajax({
                        url: '/Admin/Units/Availability/ToggleSlotStatus/' + button.data('slotid'),
                        type: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        data: {
                            __RequestVerificationToken: getToken(),
                            cityId: button.data('cityid') ?? '',
                            unitTypeId: button.data('unittypeid') ?? '',
                            unitId: button.data('unitid') ?? '',
                            year: button.data('year') ?? '',
                            isForManagement: button.data('isformanagement') ?? ''
                        }
                    }).done(function (response) {
                        applySlotState(button, response.isActive);
                    }).fail(function (xhr) {
                        button.prop('checked', !nextState);
                        swal('خطأ', xhr.responseJSON?.message || 'حدث خطأ أثناء تحديث حالة الفترة.', 'error');
                    }).always(function () {
                        button.prop('disabled', false);
                    });
                });
            });

            $(document).on('click', '.js-save-slot-price', function () {
                const button = $(this);
                const card = button.closest('.schedule-slot');
                const input = card.find('.js-slot-price-input');
                const priceValue = Number(input.val());

                if (Number.isNaN(priceValue) || priceValue < 0) {
                    swal('خطأ', 'أدخل سعرًا صحيحًا للفترة.', 'error');
                    return;
                }

                button.prop('disabled', true);
                input.prop('disabled', true);

                $.ajax({
                    url: '/Admin/Units/Availability/UpdateSlotPrice/' + button.data('slotid'),
                    type: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    data: {
                        __RequestVerificationToken: getToken(),
                        weeklyRent: priceValue,
                        cityId: button.data('cityid') ?? '',
                        unitTypeId: button.data('unittypeid') ?? '',
                        unitId: button.data('unitid') ?? '',
                        year: button.data('year') ?? '',
                        isForManagement: button.data('isformanagement') ?? ''
                    }
                }).done(function (response) {
                    const defaultPrice = Number(response.defaultPrice ?? 0);
                    const effectivePrice = Number(response.weeklyRent ?? priceValue);
                    card.find('.js-slot-default-price-display').text((defaultPrice > 0 ? defaultPrice : effectivePrice).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                    card.find('.js-slot-price-display').text(effectivePrice.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                    card.find('.js-slot-price-badge').text(response.isCustom ? 'مخصص' : 'افتراضي');
                    input.val(effectivePrice);
                    swal('تم الحفظ', response.isCustom ? 'تم حفظ سعر مخصص لهذه الفترة.' : 'تم الرجوع إلى السعر الأساسي للفترة.', 'success');
                }).fail(function (xhr) {
                    swal('خطأ', xhr.responseJSON?.message || 'تعذر تحديث سعر الفترة.', 'error');
                }).always(function () {
                    button.prop('disabled', false);
                    input.prop('disabled', false);
                });
            });
        });
    </script>
}
