@model ECM.ReservationSystem.Models.ViewModels.Admin.UnitsAvailabilityPageViewModel
@{
    ViewData["Title"] = "جدولة الوحدات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">جدولة الوحدات</h1>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label">السنة</label>
                <select name="year" class="form-select">
                    @foreach (var y in (IEnumerable<int>)ViewBag.AvailableYears)
                    {
                        <option value="@y" selected="@(Model.Year == y)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">المدينة</label>
                <select name="cityId" asp-items="ViewBag.Cities" class="form-select select2">
                    <option value="">الكل</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">نوع الوحدة</label>
                <select name="unitTypeId" asp-items="ViewBag.UnitTypes" class="form-select select2">
                    <option value="">الكل</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الفئة</label>
                <select name="isForManagement" asp-items="ViewBag.AudienceOptions" class="form-select"></select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الوحدة</label>
                <select name="unitId" asp-items="ViewBag.Units" class="form-select select2">
                    <option value="">الكل</option>
                </select>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary">بحث</button>
                <a href="/Admin/Units/Availability" class="btn btn-outline-secondary">مسح</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <strong>إنشاء الجدول</strong>
    </div>
    <div class="card-body">
        <form method="post" action="/Admin/Units/Availability/CreateSchedule" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CityId" value="@Model.CityId" />
            <input type="hidden" name="UnitTypeId" value="@Model.UnitTypeId" />
            <input type="hidden" name="IsForManagement" value="@Model.IsForManagement" />
            <div class="col-md-4">
                <label class="form-label">الوحدة</label>
                <select name="UnitId" asp-items="ViewBag.Units" class="form-select select2" required>
                    <option value="">اختر الوحدة</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">السنة</label>
                <input name="Year" class="form-control" type="number" value="@Model.Year" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">من شهر</label>
                <select name="StartMonth" class="form-select" required>
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@month</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">إلى شهر</label>
                <select name="EndMonth" class="form-select" required>
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@month</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">ملاحظات</label>
                <input name="Notes" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">اسم الفترة</label>
                <input name="SlotName" class="form-control" placeholder="مثال: الأسبوع الأول" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">إضافة الـ Slots</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Units.Any())
{
    foreach (var item in Model.Units)
    {
        var available = item.WeekAvailabilities.Count(w => w.IsAvailable);
        var reserved = item.WeekAvailabilities.Count(w => w.IsReserved);
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>@item.UnitName</strong>
                    <span class="text-muted">| @item.CityName - @item.UnitTypeName</span>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-success">متاح: @available</span>
                    <span class="badge bg-danger">محجوز: @reserved</span>
                    @if (item.IsForPensioners)
                    {
                        <span class="badge bg-info">للمعاشات</span>
                    }
                    <span class="badge @(item.IsForManagement ? "bg-dark" : "bg-secondary")">@(item.IsForManagement ? "الإدارة" : "الموظفين")</span>
                </div>
            </div>
            <div class="card-body">
                @if (item.WeekAvailabilities.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var slot in item.WeekAvailabilities)
                        {
                            var cardClass = slot.IsReserved ? "schedule-slot slot-booked" : "schedule-slot slot-available";
                            <div class="@cardClass">
                                <div class="fw-bold">@slot.SlotName</div>
                                <div>@slot.WeekStartDate.ToString("dd/MM/yyyy")</div>
                                <div>إلى @slot.WeekEndDate.ToString("dd/MM/yyyy")</div>
                                <div class="mt-1 fw-semibold">@(slot.IsReserved ? "محجوز" : "متاح")</div>
                                @if (slot.IsReserved)
                                {
                                    <div class="small">@slot.EmployeeName</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(slot.Notes))
                                {
                                    <div class="small text-muted">@slot.Notes</div>
                                }
                                @if (!slot.IsReserved && slot.SlotId.HasValue)
                                {
                                    <form method="post" action="/Admin/Units/Availability/DeleteSlot/@slot.SlotId" class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="cityId" value="@Model.CityId" />
                                        <input type="hidden" name="unitTypeId" value="@Model.UnitTypeId" />
                                        <input type="hidden" name="unitId" value="@item.UnitId" />
                                        <input type="hidden" name="year" value="@Model.Year" />
                                        <input type="hidden" name="isForManagement" value="@Model.IsForManagement" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>الأسبوع</th>
                                    <th>الحالة</th>
                                    <th>الموظف</th>
                                    <th>الملاحظات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var slot in item.WeekAvailabilities)
                                {
                                    <tr>
                                        <td>@slot.WeekStartDate.ToString("yyyy-MM-dd") إلى @slot.WeekEndDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (slot.IsReserved)
                                            {
                                                <span class="badge bg-danger">محجوز</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">متاح</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(slot.EmployeeName) ? "-" : slot.EmployeeName)</td>
                                        <td>@(string.IsNullOrWhiteSpace(slot.Notes) ? "-" : slot.Notes)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">لا توجد slots مجدولة لهذه الوحدة في السنة المختارة.</div>
                }
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">لا توجد وحدات مطابقة للفلاتر الحالية.</div>
}
