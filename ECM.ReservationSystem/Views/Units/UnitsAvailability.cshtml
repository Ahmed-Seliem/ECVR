@model ECM.ReservationSystem.Models.ViewModels.Admin.UnitsAvailabilityPageViewModel
@{
    ViewData["Title"] = "جدولة الوحدات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">جدولة الوحدات</h1>
</div>

<div class="accordion mb-3" id="filtersAccordion">
    <div class="accordion-item shadow-sm">
        <h2 class="accordion-header" id="headingFilters">
            <button class="accordion-button collapsed fw-bold"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseFilters"
                    aria-expanded="false">
                الفلاتر
            </button>
        </h2>
        <div id="collapseFilters"
             class="accordion-collapse collapse"
             data-bs-parent="#filtersAccordion">
            <div class="accordion-body">

                <form method="get" class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">السنة</label>
                        <select name="year" class="form-select select2">
                            @foreach (var y in (IEnumerable<int>)ViewBag.AvailableYears)
                            {
                                <option value="@y" selected="@(Model.Year == y)">@y</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">المدينة</label>
                        <select name="cityId" asp-items="ViewBag.Cities" class="form-select select2">
                            <option value="">الكل</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">نوع الوحدة</label>
                        <select name="unitTypeId" asp-items="ViewBag.UnitTypes" class="form-select select2">
                            <option value="">الكل</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">الفئة</label>
                        <select name="isForManagement" asp-items="ViewBag.AudienceOptions" class="form-select select2"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">الوحدة</label>
                        <select name="unitId" asp-items="ViewBag.Units" class="form-select select2">
                            <option value="">الكل</option>
                        </select>
                    </div>

                    <div class="col-md-4 d-flex gap-2 align-items-end">
                        <button type="submit" class="btn btn-primary w-50">بحث</button>
                        <a href="/Admin/Units/Availability" class="btn btn-secondary w-50">مسح</a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<div class="accordion mb-4" id="createAccordion">
    <div class="accordion-item shadow-sm">
        <h2 class="accordion-header" id="headingCreate">
            <button class="accordion-button collapsed fw-bold"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseCreate"
                    aria-expanded="false"
                    aria-controls="collapseCreate">
                إنشاء الجدول
            </button>
        </h2>

        <div id="collapseCreate"
             class="accordion-collapse collapse"
             aria-labelledby="headingCreate"
             data-bs-parent="#createAccordion">

            <div class="accordion-body">

                <form method="post"
                      action="/Admin/Units/Availability/CreateSchedule"
                      class="row g-3 align-items-end">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="CityId" value="@Model.CityId" />
                    <input type="hidden" name="UnitTypeId" value="@Model.UnitTypeId" />
                    <input type="hidden" name="IsForManagement" value="@Model.IsForManagement" />

                    <div class="col-md-4">
                        <label class="form-label">الوحدة</label>
                        <select name="UnitId"
                                asp-items="ViewBag.Units"
                                class="form-select select2"
                                required>
                            <option value="">اختر الوحدة</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">السنة</label>
                        <input name="Year"
                               class="form-control"
                               type="number"
                               value="@Model.Year"
                               required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">من شهر</label>
                        <select name="StartMonth" class="form-select select2" required>
                            @for (var month = 1; month <= 12; month++)
                            {
                                <option value="@month">@month</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">إلى شهر</label>
                        <select name="EndMonth" class="form-select select2" required>
                            @for (var month = 1; month <= 12; month++)
                            {
                                <option value="@month">@month</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">ملاحظات</label>
                        <input name="Notes" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">اسم الفترة</label>
                        <input name="SlotName"
                               class="form-control"
                               placeholder="مثال: الأسبوع الأول" />
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            إضافة الـ Slots
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@if (Model.Units.Any())
{
    <div class="accordion" id="unitsAccordion">

        @foreach (var item in Model.Units)
        {
            var available = item.WeekAvailabilities.Count(w => w.IsAvailable);
            var reserved = item.WeekAvailabilities.Count(w => w.IsReserved);
            var collapseId = "collapseUnit" + item.UnitId;

            <div class="accordion-item shadow-sm mb-3">

                <!-- Header -->
                <h2 class="accordion-header" id="heading-@item.UnitId">
                    <button class="accordion-button collapsed fw-bold"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="false"
                            aria-controls="@collapseId">

                        <div class="w-100 d-flex justify-content-between align-items-center flex-wrap gap-2">

                            <div>
                                <strong>@item.UnitName</strong>
                                <span class="text-muted">
                                    | @item.CityName - @item.UnitTypeName
                                </span>
                            </div>

                            <div class="d-flex gap-2">
                                <span class="badge bg-success">متاح: @available</span>
                                <span class="badge bg-danger">محجوز: @reserved</span>

                                @if (item.IsForPensioners)
                                {
                                    <span class="badge bg-info">للمعاشات</span>
                                }

                                <span class="badge @(item.IsForManagement ? "bg-dark" : "bg-secondary")">
                                    @(item.IsForManagement ? "الإدارة" : "الموظفين")
                                </span>
                            </div>

                        </div>
                    </button>
                </h2>

                <!-- Body -->
                <div id="@collapseId"
                     class="accordion-collapse collapse"
                     aria-labelledby="heading-@item.UnitId"
                     data-bs-parent="#unitsAccordion">

                    <div class="accordion-body">

                        @if (item.WeekAvailabilities.Any())
                        {
                            <!-- Cards -->
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @foreach (var slot in item.WeekAvailabilities)
                                {
                                    var cardClass = slot.IsReserved
                                    ? "schedule-slot slot-booked"
                                    : "schedule-slot slot-available";

                                    <div class="@cardClass">
                                        <div class="fw-bold">@slot.SlotName</div>
                                        <div>@slot.WeekStartDate.ToString("dd/MM/yyyy")</div>
                                        <div>إلى @slot.WeekEndDate.ToString("dd/MM/yyyy")</div>
                                        <div class="mt-1 fw-semibold">
                                            @(slot.IsReserved ? "محجوز" : "متاح")
                                        </div>

                                        @if (slot.IsReserved)
                                        {
                                            <div class="small">@slot.EmployeeName</div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(slot.Notes))
                                        {
                                            <div class="small text-muted">@slot.Notes</div>
                                        }

                                        @if (!slot.IsReserved && slot.SlotId.HasValue)
                                        {
                                            <form method="post"
                                                  action="/Admin/Units/Availability/DeleteSlot/@slot.SlotId"
                                                  class="mt-2">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="cityId" value="@Model.CityId" />
                                                <input type="hidden" name="unitTypeId" value="@Model.UnitTypeId" />
                                                <input type="hidden" name="unitId" value="@item.UnitId" />
                                                <input type="hidden" name="year" value="@Model.Year" />
                                                <input type="hidden" name="isForManagement" value="@Model.IsForManagement" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    <b>حذف</b>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Table -->
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle">
                                    <thead>
                                        <tr>
                                            <th>الأسبوع</th>
                                            <th>الحالة</th>
                                            <th>الموظف</th>
                                            <th>الملاحظات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var slot in item.WeekAvailabilities)
                                        {
                                            <tr>
                                                <td>
                                                    @slot.WeekStartDate.ToString("yyyy-MM-dd")
                                                    إلى
                                                    @slot.WeekEndDate.ToString("yyyy-MM-dd")
                                                </td>
                                                <td>
                                                    @if (slot.IsReserved)
                                                    {
                                                        <span class="badge bg-danger">محجوز</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">متاح</span>
                                                    }
                                            </td>
                                            <td>
                                                @(string.IsNullOrWhiteSpace(slot.EmployeeName)
                                                                                    ? "-"
                                                                                    : slot.EmployeeName)
                                                                                                    </td>
                                                                                                    <td>
                                                @(string.IsNullOrWhiteSpace(slot.Notes)
                                                                                    ? "-"
                                                                                    : slot.Notes)
                                </td>
                            </tr>
                                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                لا توجد slots مجدولة لهذه الوحدة في السنة المختارة.
                            </div>
                        }

                    </div>
                </div>

            </div>
        }

    </div>
}
else
{
    <div class="alert alert-info">
        لا توجد وحدات مطابقة للفلاتر الحالية.
    </div>
}