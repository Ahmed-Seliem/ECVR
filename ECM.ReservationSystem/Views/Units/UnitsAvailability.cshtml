@model IEnumerable<ECM.ReservationSystem.Models.ViewModels.Admin.UnitAvailabilityViewModel>
@{
    ViewData["Title"] = "جدولة الوحدات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0"><i class="fas fa-calendar-alt"></i> جدولة الوحدات</h1>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">المدينة</label>
                <select name="cityId" class="form-select select2">
                    <option value="">الكل</option>
                    @foreach (var c in (IEnumerable<ECM.ReservationSystem.Domain.Entities.City>)ViewBag.Cities)
                    {
                        if (ViewBag.CurrentCityId != null && (int)ViewBag.CurrentCityId == c.Id)
                        {
                            <option value="@c.Id" selected>@c.Name</option>
                        }
                        else
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">السنة</label>
                <select name="year" class="form-select select2">
                    @foreach (var y in (IEnumerable<int>)ViewBag.AvailableYears)
                    {
                        if ((int)ViewBag.CurrentYear == y)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
            <div class="col-lg-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="fas fa-search"></i>
                    بحث
                </button>
                <a href="/Admin/Units/Availability" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-rotate-left"></i>
                    مسح
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover datatable">
                <thead>
                    <tr>
                        <th>الوحدة</th>
                        <th>المدينة</th>
                        <th>النوع</th>
                        <th>السنة</th>
                        <th>الأسابيع المتاحة</th>
                        <th>الأسابيع المحجوزة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var available = item.WeekAvailabilities.Count(w => w.IsAvailable);
                        var reserved = item.WeekAvailabilities.Count(w => w.IsReserved);
                        <tr>
                            <td>@item.UnitName</td>
                            <td>@item.CityName</td>
                            <td>@item.UnitTypeName</td>
                            <td>@item.Year</td>
                            <td><span class="badge bg-success">@available</span></td>
                            <td><span class="badge bg-danger">@reserved</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
