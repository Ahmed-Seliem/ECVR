@model ECM.ReservationSystem.Models.ViewModels.Admin.UnitsAvailabilityPageViewModel
@{
    ViewData["Title"] = "جدولة الوحدات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@functions {
    private static string ResolveCategory(ECM.ReservationSystem.Models.ViewModels.Admin.UnitAvailabilityViewModel unit)
    {
        var unitType = unit.UnitTypeName ?? string.Empty;
        if (unitType.Contains("شقة") && unit.IsForPensioners) return "شقق معاشات";
        if (unitType.Contains("شقة")) return "شقق موظفين";
        if (unitType.Contains("فيلا")) return "فلل";
        if (unitType.Contains("شاليه")) return "شاليهات";
        return unitType;
    }
}

<div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">جدولة الوحدات</h1>
</div>

<div class="accordion mb-3" id="filtersAccordion">
    <div class="accordion-item shadow-sm">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilters">
                الفلاتر
            </button>
        </h2>
        <div id="collapseFilters" class="accordion-collapse collapse" data-bs-parent="#filtersAccordion">
            <div class="accordion-body">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">السنة</label>
                        <select name="year" class="form-select select2">
                            @foreach (var y in (IEnumerable<int>)ViewBag.AvailableYears)
                            {
                                <option value="@y" selected="@(Model.Year == y)">@y</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">المدينة</label>
                        <select name="cityId" asp-items="ViewBag.Cities" class="form-select select2">
                            <option value="">الكل</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">نوع الوحدة</label>
                        <select name="unitTypeId" asp-items="ViewBag.UnitTypes" class="form-select select2">
                            <option value="">الكل</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">الفئة</label>
                        <select name="isForManagement" asp-items="ViewBag.AudienceOptions" class="form-select select2"></select>
                    </div>
                    <div class="col-md-9">
                        <label class="form-label">الوحدة</label>
                        <select name="unitId" asp-items="ViewBag.Units" class="form-select select2">
                            <option value="">الكل</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2 align-items-end">
                        <button type="submit" class="btn btn-primary action-btn w-50">بحث</button>
                        <a href="/Admin/Units/Availability" class="btn btn-outline-secondary action-btn w-50">مسح</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="accordion mb-4" id="createAccordion">
    <div class="accordion-item shadow-sm">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCreate">
                إنشاء الجدول
            </button>
        </h2>
        <div id="collapseCreate" class="accordion-collapse collapse" data-bs-parent="#createAccordion">
            <div class="accordion-body">
                <form method="post" action="/Admin/Units/Availability/CreateSchedule" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CityId" value="@Model.CityId" />
                    <input type="hidden" name="UnitTypeId" value="@Model.UnitTypeId" />
                    <input type="hidden" name="IsForManagement" value="@Model.IsForManagement" />

                    <div class="col-md-4">
                        <label class="form-label">الوحدة</label>
                        <select name="UnitId" asp-items="ViewBag.Units" class="form-select select2" required>
                            <option value="">اختر الوحدة</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">السنة</label>
                        <input name="Year" class="form-control" type="number" value="@Model.Year" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">من شهر</label>
                        <select name="StartMonth" class="form-select select2" required>
                            @for (var month = 1; month <= 12; month++)
                            {
                                <option value="@month">@month</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">إلى شهر</label>
                        <select name="EndMonth" class="form-select select2" required>
                            @for (var month = 1; month <= 12; month++)
                            {
                                <option value="@month">@month</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">ملاحظات</label>
                        <input name="Notes" class="form-control" />
                    </div>
                    <div class="col-md-10">
                        <label class="form-label">اسم الفترة</label>
                        <input name="SlotName" class="form-control" placeholder="مثال: صيف 2026" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary action-btn w-100">إضافة الفترات</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<form id="slotDeleteTokenForm">
    @Html.AntiForgeryToken()
</form>

@if (Model.Units.Any())
{
    var cityGroups = Model.Units.GroupBy(u => u.CityName).OrderBy(g => g.Key);

    <div class="accordion" id="cityAccordion">
        @foreach (var cityGroup in cityGroups)
        {
            var cityCollapseId = $"city-{Math.Abs(cityGroup.Key.GetHashCode())}";
            var categoryGroups = cityGroup.GroupBy(ResolveCategory).OrderBy(g => g.Key).ToList();

            <div class="accordion-item shadow-sm mb-3">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#@cityCollapseId">
                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <span>@cityGroup.Key</span>
                            <span class="badge bg-primary rounded-pill">@cityGroup.Count() وحدة</span>
                        </div>
                    </button>
                </h2>
                <div id="@cityCollapseId" class="accordion-collapse collapse" data-bs-parent="#cityAccordion">
                    <div class="accordion-body">
                        <div class="accordion unit-category-accordion" id="categoryAccordion-@cityCollapseId">
                            @foreach (var categoryGroup in categoryGroups)
                            {
                                var categoryCollapseId = $"{cityCollapseId}-{Math.Abs(categoryGroup.Key.GetHashCode())}";
                                <div class="accordion-item border-0 mb-3">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed category-accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@categoryCollapseId">
                                            <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                                <span>@categoryGroup.Key</span>
                                                <span class="badge bg-secondary rounded-pill">@categoryGroup.Count() وحدة</span>
                                            </div>
                                        </button>
                                    </h2>
                                    <div id="@categoryCollapseId" class="accordion-collapse collapse" data-bs-parent="#categoryAccordion-@cityCollapseId">
                                        <div class="accordion-body px-0 pb-0">
                                            <div class="row g-3">
                                                @foreach (var item in categoryGroup)
                                                {
                                                    var available = item.WeekAvailabilities.Count(w => w.IsAvailable);
                                                    var pending = item.WeekAvailabilities.Count(w => w.IsPending);
                                                    var reserved = item.WeekAvailabilities.Count(w => w.IsReserved);

                                                    <div class="col-12">
                                                        <div class="card shadow-sm border-0 unit-availability-card">
                                                            <div class="card-body">
                                                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                                                                    <div>
                                                                        <h5 class="mb-1 fw-bold">@item.UnitName</h5>
                                                                        <div class="text-muted">@item.UnitTypeName</div>
                                                                    </div>
                                                                    @if (item.IsForPensioners)
                                                                    {
                                                                        <span class="badge stat-pill stat-pill-info">للمعاشات</span>
                                                                    }
                                                                </div>

                                                                @if (item.WeekAvailabilities.Any())
                                                                {
                                                                    <div class="slots-grid">
                                                                        @foreach (var slot in item.WeekAvailabilities)
                                                                        {
                                                                            var slotClass = slot.IsReserved
                                                                                ? "slot-booked"
                                                                                : slot.IsPending
                                                                                    ? "slot-pending"
                                                                                    : "slot-available";

                                                                            var statusText = slot.IsReserved
                                                                                ? "محجوز"
                                                                                : slot.IsPending
                                                                                    ? "معلق"
                                                                                    : "متاح";

                                                                            <div class="schedule-slot @slotClass">
                                                                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                                                    <div>
                                                                                        <div class="fw-bold">@slot.SlotName</div>
                                                                                        <div class="small text-muted">@slot.WeekStartDate.ToString("dd/MM/yyyy") - @slot.WeekEndDate.ToString("dd/MM/yyyy")</div>
                                                                                    </div>
                                                                                    <span class="badge rounded-pill slot-status-badge">@statusText</span>
                                                                                </div>

                                                                                @if (!string.IsNullOrWhiteSpace(slot.EmployeeName))
                                                                                {
                                                                                    <div class="small mb-1"><strong>الموظف:</strong> @slot.EmployeeName</div>
                                                                                }

                                                                                @if (!string.IsNullOrWhiteSpace(slot.Notes))
                                                                                {
                                                                                    <div class="small text-muted mb-2">@slot.Notes</div>
                                                                                }

                                                                                @if (slot.IsAvailable && slot.SlotId.HasValue)
                                                                                {
                                                                                    <button type="button"
                                                                                            class="btn btn-outline-danger btn-sm action-btn js-delete-slot"
                                                                                            data-slotid="@slot.SlotId"
                                                                                            data-slotname="@slot.SlotName"
                                                                                            data-cityid="@Model.CityId"
                                                                                            data-unittypeid="@Model.UnitTypeId"
                                                                                            data-unitid="@item.UnitId"
                                                                                            data-year="@Model.Year"
                                                                                            data-isformanagement="@Model.IsForManagement">
                                                                                        حذف الفترة
                                                                                    </button>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </div>

                                                                    <div class="d-flex flex-wrap gap-2 stats-badges mt-4 justify-content-center">
                                                                        <span class="badge stat-pill stat-pill-success">متاح: @available</span>
                                                                        <span class="badge stat-pill stat-pill-warning">معلق: @pending</span>
                                                                        <span class="badge stat-pill stat-pill-danger">محجوز: @reserved</span>
                                                                        <span class="badge stat-pill stat-pill-neutral">إجمالي الفترات: @item.WeekAvailabilities.Count</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="alert alert-warning mb-0">لا توجد فترات مجدولة لهذه الوحدة.</div>
                                                                }

                                                                <div class="d-flex justify-content-center flex-wrap gap-2 mt-4">
                                                                    <a href="/Admin/Units/Details/@item.UnitId" class="btn btn-outline-primary action-btn">التفاصيل</a>
                                                                    <a href="/Admin/Pricings?unitId=@item.UnitId" class="btn btn-outline-success action-btn">التسعير</a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        لا توجد وحدات مطابقة للفلاتر الحالية.
    </div>
}

@section Scripts {
    <script>
        $(function () {
            $(document).on('click', '.js-delete-slot', function () {
                const button = $(this);
                const slotId = button.data('slotid');
                const slotName = button.data('slotname');

                swal({
                    title: 'تأكيد الحذف',
                    text: `سيتم حذف الفترة: ${slotName}`,
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، حذف',
                    cancelButtonText: 'إلغاء',
                    closeOnConfirm: true
                }, function (isConfirm) {
                    if (!isConfirm) return;

                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '/Admin/Units/Availability/DeleteSlot/' + slotId;

                    const token = document.querySelector('#slotDeleteTokenForm input[name="__RequestVerificationToken"]').value;
                    const fields = {
                        __RequestVerificationToken: token,
                        cityId: button.data('cityid') ?? '',
                        unitTypeId: button.data('unittypeid') ?? '',
                        unitId: button.data('unitid') ?? '',
                        year: button.data('year') ?? '',
                        isForManagement: button.data('isformanagement') ?? ''
                    };

                    Object.entries(fields).forEach(([key, value]) => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = key;
                        input.value = value;
                        form.appendChild(input);
                    });

                    document.body.appendChild(form);
                    form.submit();
                });
            });
        });
    </script>
}
