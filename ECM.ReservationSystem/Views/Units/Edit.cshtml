@model ECM.ReservationSystem.Domain.Entities.Unit
@{
    ViewData["Title"] = "تحرير الوحدة";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">تحرير الوحدة</h1>
    <div class="d-flex gap-2">
        <a href="/Admin/Units" class="btn btn-secondary">العودة للقائمة</a>
        <a href="/Admin/Units/Details/@Model.Id" class="btn btn-outline-info">عرض التفاصيل</a>
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="CreatedByUserId" />

            <div class="row g-4">
                <div class="col-12">
                    <h6 class="text-muted mb-0">البيانات الأساسية</h6>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label asp-for="Code" class="form-label">رقم الوحدة</label>
                    <input asp-for="Code" class="form-control" required />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="CityId" class="form-label">المدينة</label>
                    <select asp-for="CityId" asp-items="ViewBag.Cities" class="form-select" required></select>
                    <span asp-validation-for="CityId" class="text-danger"></span>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="UnitTypeId" class="form-label">نوع الوحدة</label>
                    <select asp-for="UnitTypeId" asp-items="ViewBag.UnitTypes" class="form-select" required></select>
                    <span asp-validation-for="UnitTypeId" class="text-danger"></span>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="UnitFacadeId" class="form-label">الواجهة</label>
                    <select asp-for="UnitFacadeId" asp-items="ViewBag.UnitFacades" class="form-select">
                        <option value="">اختر الواجهة</option>
                    </select>
                    <span asp-validation-for="UnitFacadeId" class="text-danger"></span>
                </div>

                <div class="col-12 pt-2">
                    <h6 class="text-muted mb-0">تفاصيل الطابق والسعة</h6>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label asp-for="FloorType" class="form-label">نوع الدور</label>
                    <select asp-for="FloorType" asp-items="ViewBag.FloorTypes" class="form-select"></select>
                    <span asp-validation-for="FloorType" class="text-danger"></span>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="FloorNumber" class="form-label">رقم الدور</label>
                    <input asp-for="FloorNumber" type="number" class="form-control" />
                    <span asp-validation-for="FloorNumber" class="text-danger"></span>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="DefaultCapacity" class="form-label">السعة</label>
                    <input asp-for="DefaultCapacity" type="number" class="form-control" />
                    <span asp-validation-for="DefaultCapacity" class="text-danger"></span>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="RoomCount" class="form-label">عدد الغرف</label>
                    <input asp-for="RoomCount" type="number" class="form-control" />
                    <span asp-validation-for="RoomCount" class="text-danger"></span>
                </div>

                <div class="col-12 pt-2">
                    <h6 class="text-muted mb-0">الإعدادات</h6>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label asp-for="Year" class="form-label">السنة</label>
                    <select asp-for="Year" asp-items="ViewBag.Years" class="form-select"></select>
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>
                <div class="col-lg-4 col-md-6 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">نشط</label>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsForPensioners" class="form-check-input" type="checkbox" />
                        <label asp-for="IsForPensioners" class="form-check-label">للمعاشات</label>
                    </div>
                </div>

                <div class="col-12 pt-2">
                    <label asp-for="Description" class="form-label">الوصف</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end gap-2">
                <a href="/Admin/Units" class="btn btn-secondary">إلغاء</a>
                <button type="submit" class="btn btn-primary">حفظ</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
