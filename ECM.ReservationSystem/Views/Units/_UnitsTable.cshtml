@model IEnumerable<ECM.ReservationSystem.Models.Entities.Unit>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover datatable">
            <thead>
                <tr>
                    <th>الكود</th>
                    <th>الاسم</th>
                    <th>المدينة</th>
                    <th>النوع</th>
                    <th>السعة</th>
                    <th>الدور</th>
                    <th>السنة</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model)
                {
                    <tr>
                        <td><code>@(string.IsNullOrWhiteSpace(unit.Code) ? "-" : unit.Code)</code></td>
                        <td>@unit.Name</td>
                        <td>@unit.City?.Name</td>
                        <td>@unit.UnitType?.Name</td>
                        <td>@unit.DefaultCapacity / @unit.MaxCapacity</td>
                        <td>@unit.FloorNumber</td>
                        <td>@unit.Year</td>
                        <td>
                            @if (unit.IsActive)
                            {
                                <span class="badge bg-success">نشط</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">غير نشط</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <a href="/Admin/Units/Details/@unit.Id" class="btn btn-sm btn-outline-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning js-edit-unit"
                                        data-id="@unit.Id"
                                        data-name="@unit.Name"
                                        data-code="@unit.Code"
                                        data-description="@unit.Description"
                                        data-defaultcapacity="@unit.DefaultCapacity"
                                        data-maxcapacity="@unit.MaxCapacity"
                                        data-floortype="@((int)unit.FloorType)"
                                        data-floornumber="@unit.FloorNumber"
                                        data-year="@unit.Year"
                                        data-active="@unit.IsActive"
                                        data-cityid="@unit.CityId"
                                        data-unittypeid="@unit.UnitTypeId"
                                        data-createdat="@unit.CreatedAt.ToString("o")">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger js-delete-unit"
                                        data-id="@unit.Id"
                                        data-name="@unit.Name">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-building fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">لا توجد وحدات مضافة</h5>
    </div>
}
