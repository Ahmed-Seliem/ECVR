@model IEnumerable<ECM.ReservationSystem.Models.DTOs.HotelTrips.HotelResponseDto>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover datatable align-middle">
            <thead>
                <tr>
                    <th>الفندق</th>
                    <th>المدينة</th>
                    <th>سعر البالغ</th>
                    <th>سعر الطفل</th>
                    <th>سعر المرافق</th>
                    <th>تذاكر الموظفين</th>
                    <th>تذاكر المعاشات</th>
                    <th>نشط</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hotel in Model)
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(hotel.NameAr) ? hotel.Name : hotel.NameAr)</td>
                        <td>@hotel.CityName</td>
                        <td>@hotel.AdultTicketPrice.ToString("N2")</td>
                        <td>@hotel.ChildTicketPrice.ToString("N2")</td>
                        <td>@hotel.CompanionTicketPrice.ToString("N2")</td>
                        <td>
                            <span class="badge bg-primary">@hotel.EmployeeTicketQuantity</span>
                            <span class="badge bg-@(hotel.EmployeeRemaining > 0 ? "success" : "danger")">متبقي @hotel.EmployeeRemaining</span>
                        </td>
                        <td>
                            <span class="badge bg-primary">@hotel.PensionTicketQuantity</span>
                            <span class="badge bg-@(hotel.PensionRemaining > 0 ? "success" : "danger")">متبقي @hotel.PensionRemaining</span>
                        </td>
                        <td>
                            @if (hotel.IsActive)
                            {
                                <span class="badge bg-success">نعم</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">لا</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning js-edit-hotel"
                                        data-id="@hotel.Id"
                                        data-cityid="@hotel.HotelCityId"
                                        data-name="@hotel.Name"
                                        data-namear="@hotel.NameAr"
                                        data-adultprice="@hotel.AdultTicketPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-childprice="@hotel.ChildTicketPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-companionprice="@hotel.CompanionTicketPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-employeetickets="@hotel.EmployeeTicketQuantity"
                                        data-pensiontickets="@hotel.PensionTicketQuantity"
                                        data-active="@hotel.IsActive">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger js-delete-hotel"
                                        data-id="@hotel.Id">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-hotel fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">لا توجد فنادق مضافة</h5>
    </div>
}
