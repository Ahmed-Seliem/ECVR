@using ECM.ReservationSystem.Domain.Entities.OneDayTrips
@model IEnumerable<ECM.ReservationSystem.Models.DTOs.OneDayTrips.TripResponseDto>

@functions {
    (string CssClass, string Label) GetTripStatus(TripStatus status) => status switch
    {
        TripStatus.Open => ("success", "مفتوحة"),
        TripStatus.Closed => ("secondary", "مقفولة"),
        TripStatus.Cancelled => ("danger", "ملغاة"),
        _ => ("light", status.ToString())
    };
}

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover datatable align-middle">
            <thead>
                <tr>
                    <th>المكان</th>
                    <th>تاريخ الرحلة</th>
                    <th>سعر البالغ</th>
                    <th>سعر الطفل</th>
                    <th>الحالة</th>
                    <th>عدد الحجوزات</th>
                    <th>نشطة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trip in Model)
                {
                    var status = GetTripStatus(trip.Status);
                    <tr>
                        <td>@trip.LocationName</td>
                        <td>@trip.TripDate.ToString("dd/MM/yyyy")</td>
                        <td>@trip.AdultTicketPrice.ToString("N2")</td>
                        <td>@trip.ChildTicketPrice.ToString("N2")</td>
                        <td><span class="badge bg-@status.CssClass">@status.Label</span></td>
                        <td><span class="badge bg-info">@trip.BookingsCount</span></td>
                        <td>
                            @if (trip.IsActive)
                            {
                                <span class="badge bg-success">نعم</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">لا</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning js-edit-trip"
                                        data-id="@trip.Id"
                                        data-locationid="@trip.TripLocationId"
                                        data-tripdate="@trip.TripDate.ToString("yyyy-MM-dd")"
                                        data-adultprice="@trip.AdultTicketPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-childprice="@trip.ChildTicketPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-status="@((int)trip.Status)"
                                        data-notes="@trip.Notes"
                                        data-active="@trip.IsActive">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger js-delete-trip"
                                        data-id="@trip.Id">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-route fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">لا توجد رحلات مضافة</h5>
    </div>
}
