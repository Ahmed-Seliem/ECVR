@model IEnumerable<ECM.ReservationSystem.Domain.Entities.UnitType>
@{
    ViewData["Title"] = "إدارة أنواع الوحدات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">
        <i class="fas fa-home"></i>
        إدارة أنواع الوحدات
    </h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUnitTypeModal">
        <i class="fas fa-plus"></i>
        إضافة نوع
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @await Html.PartialAsync("_UnitTypesTable", Model)
    </div>
</div>

<div class="modal fade" id="createUnitTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/Admin/UnitTypes/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">إضافة نوع وحدة</h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الاسم (EN)</label>
                            <input name="Name" class="form-control" required maxlength="50" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الاسم (AR)</label>
                            <input name="NameAr" class="form-control" maxlength="50" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الوصف</label>
                        <textarea name="Description" class="form-control" rows="3" maxlength="200"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="createIsForManagement" name="IsForManagement" value="true" />
                                <input type="hidden" name="IsForManagement" value="false" />
                                <label class="form-check-label" for="createIsForManagement">للإدارة</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="createUnitTypeIsActive" name="IsActive" value="true" checked />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label" for="createUnitTypeIsActive">نشط</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editUnitTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editUnitTypeForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editUnitTypeId" name="Id" />
                <input type="hidden" id="editUnitTypeCreatedAt" name="CreatedAt" />
                <div class="modal-header">
                    <h5 class="modal-title">تعديل نوع الوحدة</h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الاسم (EN)</label>
                            <input id="editUnitTypeName" name="Name" class="form-control" required maxlength="50" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الاسم (AR)</label>
                            <input id="editUnitTypeNameAr" name="NameAr" class="form-control" maxlength="50" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الوصف</label>
                        <textarea id="editUnitTypeDescription" name="Description" class="form-control" rows="3" maxlength="200"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="editIsForManagement" name="IsForManagement" value="true" />
                                <input type="hidden" name="IsForManagement" value="false" />
                                <label class="form-check-label" for="editIsForManagement">للإدارة</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="editUnitTypeIsActive" name="IsActive" value="true" />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label" for="editUnitTypeIsActive">نشط</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ التغييرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const editModal = new bootstrap.Modal(document.getElementById('editUnitTypeModal'));

            $(document).on('click', '.js-edit-unittype', function () {
                const row = $(this);
                const id = row.data('id');
                $('#editUnitTypeId').val(id);
                $('#editUnitTypeName').val(row.data('name'));
                $('#editUnitTypeNameAr').val(row.data('namear'));
                $('#editUnitTypeDescription').val(row.data('description'));
                $('#editUnitTypeCreatedAt').val(row.data('createdat'));
                $('#editIsForManagement').prop('checked', row.data('management') === true || row.data('management') === 'True');
                $('#editUnitTypeIsActive').prop('checked', row.data('active') === true || row.data('active') === 'True');
                $('#editUnitTypeForm').attr('action', '/Admin/UnitTypes/Edit/' + id);
                editModal.show();
            });

            $(document).on('click', '.js-delete-unittype', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                swal({
                    title: 'تأكيد الحذف',
                    text: `سيتم حذف نوع الوحدة: ${name}`,
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، حذف',
                    cancelButtonText: 'إلغاء',
                    closeOnConfirm: true
                }, function (isConfirm) {
                    if (!isConfirm) return;
                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '/Admin/UnitTypes/Delete/' + id;
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);
                    document.body.appendChild(form);
                    form.submit();
                });
            });
        });
    </script>
}
