@model IEnumerable<ECM.ReservationSystem.Models.Entities.UnitType>
@{
    ViewData["Title"] = "إدارة أنواع الوحدات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="fas fa-th-large"></i>
        إدارة أنواع الوحدات
    </h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/Admin/UnitTypes/Create" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            إضافة نوع وحدة جديد
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>الاسم</th>
                                    <th>الاسم بالعربية</th>
                                    <th>الوصف</th>
                                    <th>للإدارة</th>
                                    <th>الحالة</th>
                                    <th>تاريخ الإنشاء</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var unitType in Model)
                                {
                                    <tr>
                                        <td>@unitType.Name</td>
                                        <td>@unitType.NameAr</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(unitType.Description))
                                            {
                                                <span title="@unitType.Description">
                                                    @(unitType.Description.Length > 50 ? unitType.Description.Substring(0, 50) + "..." : unitType.Description)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (unitType.IsForManagement)
                                            {
                                                <span class="badge bg-warning text-dark">للإدارة</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">للعملاء</span>
                                            }
                                        </td>
                                        <td>
                                            @if (unitType.IsActive)
                                            {
                                                <span class="badge bg-success">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">غير نشط</span>
                                            }
                                        </td>
                                        <td>@unitType.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="/Admin/UnitTypes/Edit/@unitType.Id" class="btn btn-sm btn-outline-warning">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="/Admin/UnitTypes/Delete/@unitType.Id" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-th-large fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">لا توجد أنواع وحدات مضافة</h5>
                        <p class="text-muted">ابدأ بإضافة أنواع الوحدات المتاحة</p>
                        <a href="/Admin/UnitTypes/Create" class="btn btn-primary">
                            <i class="fas fa-plus"></i>
                            إضافة أول نوع وحدة
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>