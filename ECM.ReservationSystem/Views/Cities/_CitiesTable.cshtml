@model IEnumerable<ECM.ReservationSystem.Domain.Entities.City>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover datatable">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>الاسم بالعربية</th>
                    <th>عدد الوحدات</th>
                    <th>الحالة</th>
                    <th>تاريخ الإنشاء</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var city in Model)
                {
                    <tr>
                        <td>@city.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(city.NameAr) ? "-" : city.NameAr)</td>
                        <td><span class="badge bg-info">@city.Units.Count</span></td>
                        <td>
                            @if (city.IsActive)
                            {
                                <span class="badge bg-success">نشط</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">غير نشط</span>
                            }
                        </td>
                        <td>@city.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="btn-group">
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning js-edit-city"
                                        data-id="@city.Id"
                                        data-name="@city.Name"
                                        data-namear="@city.NameAr"
                                        data-active="@city.IsActive"
                                        data-createdat="@city.CreatedAt.ToString("o")">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger js-delete-city"
                                        data-id="@city.Id"
                                        data-name="@city.Name">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-map-marker-alt fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">لا توجد مدن مضافة</h5>
    </div>
}
