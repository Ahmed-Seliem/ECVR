@model IEnumerable<ECM.ReservationSystem.Models.Entities.City>
@{
    ViewData["Title"] = "إدارة المدن";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="fas fa-map-marker-alt"></i>
        إدارة المدن
    </h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/Admin/Cities/Create" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            إضافة مدينة جديدة
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>الاسم</th>
                                    <th>الاسم بالعربية</th>
                                    <th>عدد الوحدات</th>
                                    <th>الحالة</th>
                                    <th>تاريخ الإنشاء</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var city in Model)
                                {
                                    <tr>
                                        <td>@city.Name</td>
                                        <td>@city.NameAr</td>
                                        <td>
                                            <span class="badge bg-info">@city.Units.Count</span>
                                        </td>
                                        <td>
                                            @if (city.IsActive)
                                            {
                                                <span class="badge bg-success">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">غير نشط</span>
                                            }
                                        </td>
                                        <td>@city.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="/Admin/Cities/Details/@city.Id" class="btn btn-sm btn-outline-info">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="/Admin/Cities/Edit/@city.Id" class="btn btn-sm btn-outline-warning">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="/Admin/Cities/Delete/@city.Id" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-map-marker-alt fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">لا توجد مدن مضافة</h5>
                        <p class="text-muted">ابدأ بإضافة المدن المتاحة للحجز</p>
                        <a href="/Admin/Cities/Create" class="btn btn-primary">
                            <i class="fas fa-plus"></i>
                            إضافة أول مدينة
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>