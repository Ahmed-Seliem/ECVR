@model IEnumerable<ECM.ReservationSystem.Domain.Entities.ReservationType>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover datatable">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>الاسم بالعربية</th>
                    <th>الوصف</th>
                    <th>الحد الأقصى</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.NameAr</td>
                        <td>@item.Description</td>
                        <td><span class="badge bg-info">@item.MaxGuestsLimit</span></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">نشط</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">غير نشط</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning js-edit-reservation-type"
                                        data-id="@item.Id"
                                        data-name="@item.Name"
                                        data-namear="@item.NameAr"
                                        data-description="@item.Description"
                                        data-maxguests="@item.MaxGuestsLimit"
                                        data-active="@item.IsActive">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger js-delete-reservation-type"
                                        data-id="@item.Id"
                                        data-name="@item.Name">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-tags fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">لا توجد أنواع حجز</h5>
    </div>
}
