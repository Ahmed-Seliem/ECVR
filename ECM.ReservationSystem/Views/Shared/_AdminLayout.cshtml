@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using System.Security.Claims
@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var displayName = User?.Claims?
    .FirstOrDefault(c => c.Type == "DisplayName")?
    .Value ?? "User";
    var currentPath = Context?.Request?.Path.Value ?? "/";

    bool IsActive(string prefix, bool exact = false)
    {
        if (exact)
        {
            return string.Equals(currentPath, prefix, StringComparison.OrdinalIgnoreCase);
        }

        return currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    }
}


<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة الحجوزات ECM</title>
    <link rel="icon" href="~/images/logo.svg" />
    <!-- Core CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="~/lib/DataTable/dataTables.bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/select2/dist/css/select2.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-sweetalert/dist/sweetalert.css" />
    <link rel="stylesheet" href="~/lib/flatpicker/flatpickr.min.css" />
    <link href="~/css/main.css" rel="stylesheet" />
    <style>
        .navbar-brand {
            padding: 0;
            display: flex;
            align-items: center;
        }

        .newLogo {
            height: 40px;
            width: auto;
        }

        .logo-text {
            font-size: 18px;
            font-weight: 600;
            white-space: nowrap;
        }

        .brand-logo img,
        .brand-logo-collapsed img {
            display: block;
        }

        /* Make the sidebar scrollable when items exceed the viewport height */
        .aside {
            overflow-y: auto;
        }

        /* One Day Trips: collapsible sidebar submenu */
        .sidebar .nav .submenu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar .nav .submenu li a {
            padding-inline-start: 2.5rem;
            font-size: 0.9rem;
        }

        .sidebar .nav a .menu-arrow {
            margin-inline-start: auto;
            font-size: 0.75rem;
            transition: transform 0.2s ease;
        }

        .sidebar .nav a[aria-expanded="true"] .menu-arrow {
            transform: rotate(180deg);
        }

        /* Parent-group "active" must not bleed into every sub-item;
           only the truly-active sub-item (or hover) keeps the highlight */
        .sidebar .nav li.active .submenu li a {
            background: transparent;
            color: var(--dark-color);
            transform: none;
        }

            .sidebar .nav li.active .submenu li.active a,
            .sidebar .nav li.active .submenu li a:hover {
                background: linear-gradient(135deg, var(--primary-color));
                color: white;
                transform: translateX(-5px);
            }
    </style>
   
</head>
<body>
    <!-- Top Navigation -->
    <header class="topnavbar-wrapper">
        <nav class="navbar navbar-expand-lg topnavbar">
            <div class="container-fluid">
                <button class="sidebar-toggle me-3" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>

                <a href="/" class="navbar-brand d-flex align-items-center">
                    <div class="brand-logo d-flex align-items-center">
                        <img src="/images/logo.png" alt="ECMSystem" class="newLogo me-2">
                        <span class="logo-text">نظام إدارة الحجوزات</span>
                    </div>
                </a>

                <div class="ms-auto">
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle me-2"></i>
                                @displayName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item" href="/Account/Logout">
                                        <i class="fas fa-sign-out-alt me-2"></i> تسجيل الخروج
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Sidebar -->
    <aside class="aside" id="sidebar">
        <div class="aside-inner">
            <nav class="sidebar">
                <ul class="nav">
                    <li class="@(IsActive("/", exact: true) || IsActive("/Home") ? "active" : "")">
                        <a href="/">
                            <i class="fas fa-tachometer-alt"></i>
                            <span>لوحة التحكم</span>
                        </a>
                    </li>
                    <li class="@(IsActive("/Admin/Cities") ? "active" : "")">
                        <a href="/Admin/Cities">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>المدن</span>
                        </a>
                    </li>
                    <li class="@(IsActive("/Admin/TransportQuotas") ? "active" : "")">
                        <a href="/Admin/TransportQuotas">
                            <i class="fas fa-bus"></i>
                            <span>سعات النقل</span>
                        </a>
                    </li>
@*                     <li class="@(IsActive("/Admin/ReservationTypes") ? "active" : "")">
                        <a href="/Admin/ReservationTypes">
                            <i class="fas fa-tags"></i>
                            <span>أنواع الحجز</span>
                        </a>
                    </li> *@
                    <li class="@(IsActive("/Admin/UnitTypes") ? "active" : "")">
                        <a href="/Admin/UnitTypes">
                            <i class="fas fa-home"></i>
                            <span>أنواع الوحدات</span>
                        </a>
                    </li>
                    <li class="@(IsActive("/Admin/UnitFacades") ? "active" : "")">
                        <a href="/Admin/UnitFacades">
                            <i class="fas fa-border-style"></i>
                            <span>واجهات الوحدات</span>
                        </a>
                    </li>
                    <li class="@(IsActive("/Admin/Units") && !IsActive("/Admin/Units/Availability") ? "active" : "")">
                        <a href="/Admin/Units">
                            <i class="fas fa-building"></i>
                            <span>الوحدات</span>
                        </a>
                    </li>
                    <li class="@(IsActive("/Admin/Pricings") || IsActive("/Admin/Pricing") ? "active" : "")">
                        <a href="/Admin/Pricings">
                            <i class="fas fa-dollar-sign"></i>
                            <span>تسعير الوحدات</span>
                        </a>
                    </li>
                    <li class="@(IsActive("/Admin/Units/Availability") ? "active" : "")">
                        <a href="/Admin/Units/Availability">
                            <i class="fas fa-calendar-alt"></i>
                            <span>جدولة الوحدات</span>
                        </a>
                    </li>
                    <li class="@(IsActive("/Admin/Reservations") ? "active" : "")">
                        <a href="/Admin/Reservations">
                            <i class="fas fa-calendar-check"></i>
                            <span>الحجوزات</span>
                        </a>
                    </li>
                    @{
                        var oneDayTripsActive = IsActive("/Admin/TripLocations")
                            || IsActive("/Admin/Trips")
                            || IsActive("/Admin/TripBookings")
                            || IsActive("/Admin/OneDayTripReports");
                    }
                    <li class="@(oneDayTripsActive ? "active" : "")">
                        <a href="#oneDayTripsMenu" data-bs-toggle="collapse" role="button"
                           aria-expanded="@(oneDayTripsActive ? "true" : "false")" aria-controls="oneDayTripsMenu">
                            <i class="fas fa-bus-alt"></i>
                            <span>رحلات اليوم الواحد</span>
                            <i class="fas fa-chevron-down menu-arrow"></i>
                        </a>
                        <ul class="submenu collapse @(oneDayTripsActive ? "show" : "")" id="oneDayTripsMenu">
                            <li class="@(IsActive("/Admin/TripLocations") ? "active" : "")">
                                <a href="/Admin/TripLocations">
                                    <i class="fas fa-map-marked-alt"></i>
                                    <span>الأماكن</span>
                                </a>
                            </li>
                            <li class="@(IsActive("/Admin/Trips") ? "active" : "")">
                                <a href="/Admin/Trips">
                                    <i class="fas fa-route"></i>
                                    <span>الرحلات</span>
                                </a>
                            </li>
                            <li class="@(IsActive("/Admin/TripBookings") ? "active" : "")">
                                <a href="/Admin/TripBookings">
                                    <i class="fas fa-ticket-alt"></i>
                                    <span>الحجوزات</span>
                                </a>
                            </li>
                            <li class="@(IsActive("/Admin/OneDayTripReports") ? "active" : "")">
                                <a href="/Admin/OneDayTripReports">
                                    <i class="fas fa-chart-bar"></i>
                                    <span>التقارير</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="@(IsActive("/Admin/Reports") ? "active" : "")">
                        <a href="/Admin/Reports">
                            <i class="fas fa-chart-bar"></i>
                            <span>التقارير</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Main Content -->
    <section>
        <div class="content-wrapper">
            <!-- Alert Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <main role="main">
                @RenderBody()
            </main>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <span>© Intalio @DateTime.Now.Year - نظام إدارة الحجوزات ECM - جميع الحقوق محفوظة</span>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/DataTable/jquery.dataTables.min.js"></script>
    <script src="~/lib/DataTable/dataTables.bootstrap.min.js"></script>
    <script src="~/lib/select2/dist/js/select2.js"></script>
    <script src="~/lib/bootstrap-sweetalert/dist/sweetalert.min.js"></script>
    <script src="~/lib/flatpicker/flatpickr.js"></script>
    <script src="~/lib/flatpicker/flatpickrAr.js"></script>

    <script>
        // Toggle Sidebar (desktop: collapse, mobile: offcanvas)
        function toggleSidebar() {
            const isMobile = window.matchMedia('(max-width: 768px)').matches;
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebarBackdrop');

            if (isMobile) {
                sidebar.classList.toggle('show');
                backdrop.classList.toggle('show');
            } else {
                document.body.classList.toggle('sidebar-collapsed');
            }
        }

        function closeMobileSidebar() {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            sidebar.classList.remove('show');
            backdrop.classList.remove('show');
        }

        // Initialize DataTables
        $(document).ready(function() {
            $('#sidebarBackdrop').on('click', closeMobileSidebar);
            $('.sidebar .nav a').on('click', function () {
                if (window.matchMedia('(max-width: 768px)').matches) {
                    closeMobileSidebar();
                }
            });

            $(window).on('resize', function () {
                if (!window.matchMedia('(max-width: 768px)').matches) {
                    closeMobileSidebar();
                }
                if (window.matchMedia('(max-width: 768px)').matches) {
                    document.body.classList.remove('sidebar-collapsed');
                }
            });

            $('.datatable').DataTable({
                language: {
                    decimal: "",
                    emptyTable: "لا توجد بيانات",
                    info: "عرض _START_ إلى _END_ من _TOTAL_ صف",
                    infoEmpty: "عرض 0 إلى 0 من 0 صف",
                    infoFiltered: "(تمت التصفية من _MAX_ صف)",
                    lengthMenu: "عرض _MENU_ صف",
                    loadingRecords: "جاري التحميل...",
                    processing: "جاري المعالجة...",
                    search: "بحث:",
                    zeroRecords: "لا توجد نتائج مطابقة",
                    paginate: {
                        first: "الأول",
                        last: "الأخير",
                        next: "التالي ›",
                        previous: "‹ السابق"
                    }
                },
                responsive: true,
                pageLength: 10,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "الكل"]]
            });

            // Initialize Select2
            $('.select2').each(function () {
                if (!$(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2({ theme: 'default', width: '100%' });
                }
            });

            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut();
            }, 5000);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
