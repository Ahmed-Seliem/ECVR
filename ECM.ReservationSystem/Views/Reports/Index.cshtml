@using ECM.ReservationSystem.Models.ViewModels.Admin
@using Microsoft.AspNetCore.Mvc.Rendering
@model ReportsIndexViewModel
@{
    ViewData["Title"] = "التقارير";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var cities = ViewBag.Cities as SelectList;
    var unitTypes = ViewBag.UnitTypes as SelectList;
    var years = ViewBag.Years as SelectList;
    var weeks = ViewBag.Weeks as SelectList;
    var statuses = ViewBag.Statuses as SelectList;
}

<style>
    .reports-page { direction: rtl; }
    .reports-hero, .reports-filter, .report-group { border: 0; border-radius: 24px; box-shadow: 0 16px 34px rgba(15,23,42,.08); }
    .reports-hero { padding: 1.25rem 1.5rem; margin-bottom: 1.25rem; background: linear-gradient(135deg,#eef7f3,#fff,#f7f1e5); }
    .reports-hero h1 { margin: 0; font-weight: 800; color: #17324d; }
    .reports-hero p { margin: .35rem 0 0; color: #66788a; }
    .reports-filter { margin-bottom: 1rem; }
    .reports-filter .card-header, .report-group .card-header { background: #fffaf2; border-bottom: 1px solid #f0e1c8; font-weight: 800; color: #6f4e1f; }
</style>

<div class="reports-page">
    <div class="reports-hero">
        <h1>تقارير الحجوزات</h1>
    </div>

    <div class="card reports-filter">
        <div class="card-header">الفلاتر</div>
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">السنة</label>
                    <select name="year" class="form-select select2">
                        @foreach (var year in years ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@year.Value" selected="@year.Selected">@year.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">المدينة</label>
                    <select name="cityId" class="form-select select2">
                        <option value="">الكل</option>
                        @foreach (var city in cities ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@city.Value" selected="@city.Selected">@city.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">نوع الوحدة</label>
                    <select name="unitTypeId" class="form-select select2">
                        <option value="">الكل</option>
                        @foreach (var unitType in unitTypes ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@unitType.Value" selected="@unitType.Selected">@unitType.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">الفوج</label>
                    <select name="weekId" class="form-select select2">
                        <option value="">الكل</option>
                        @foreach (var week in weeks ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@week.Value" selected="@week.Selected">@week.Text</option>
                        }
                    </select>
                </div>
@*                 <div class="col-md-2">
                    <label class="form-label">الحالة</label>
                    <select name="status" class="form-select select2">
                        <option value="">الكل</option>
                        @foreach (var status in statuses ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@status.Value" selected="@status.Selected">@status.Text</option>
                        }
                    </select>
                </div> *@
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-primary">بحث</button>
                </div>
                <div class="col-md-1 d-grid">
                    <a href="/Admin/Reports" class="btn btn-outline-secondary">مسح</a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Groups.Any())
    {
        <div class="alert alert-info">لا توجد حجوزات مطابقة للفلاتر الحالية.</div>
    }
    else
    {
        foreach (var group in Model.Groups)
        {
            <div class="card report-group mb-3">
                <div class="card-header d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <strong>@group.CityName</strong>
                        <span class="text-muted">| @group.WeekStartDate.ToString("dd/MM/yyyy") - @group.WeekEndDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge text-bg-primary">الحجوزات: @group.ReservationCount</span>
                        <span class="badge text-bg-success">الأفراد: @group.PassengerCount</span>
                        <span class="badge text-bg-dark">الإجمالي: @group.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>الموظف</th>
                                    <th>الهاتف</th>
                                    <th>الوحدة</th>
                                    <th>النوع</th>
                                    <th>عدد الأفراد</th>
                                    <th>النقل</th>
                                    <th>الإجمالي</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group.Items)
                                {
                                    <tr>
                                        <td>@item.ReservationId</td>
                                        <td>
                                            <div>@item.EmployeeName</div>
                                            <small class="text-muted">@item.EmployeeNumber</small>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "-" : item.PhoneNumber)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.UnitCode) ? item.UnitName : $"{item.UnitCode} - {item.UnitName}")</td>
                                        <td>@item.UnitTypeName</td>
                                        <td>@item.NumberOfGuests</td>
                                        <td>@(item.IsTransportationRequired ? "مطلوب" : "غير مطلوب")</td>
                                        <td>@item.TotalAmount.ToString("N2")</td>
                                        <td>@item.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>
